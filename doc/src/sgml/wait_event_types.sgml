    </thead>

    <tbody>
     <row>
      <entry><literal>ClientRead</literal></entry>
      <entry>等待从客户端读取数据。</entry>
     </row>
     <row>
      <entry><literal>ClientWrite</literal></entry>
      <entry>等待向客户端写入数据。</entry>
     </row>
