<!--
doc/src/sgml/ref/create_table.sgml
PostgreSQL documentation
-->

<refentry id="sql-createtable">
 <indexterm zone="sql-createtable">
  <primary>CREATE TABLE</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>CREATE TABLE</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>CREATE TABLE</refname>
  <refpurpose>定义一个新表</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
CREATE [ [ GLOBAL | LOCAL ] { TEMPORARY | TEMP } | UNLOGGED ] TABLE [ IF NOT EXISTS ] <replaceable class="parameter">table_name</replaceable> ( [
  { <replaceable class="parameter">column_name</replaceable> <replaceable class="parameter">data_type</replaceable> [ STORAGE { PLAIN | EXTERNAL | EXTENDED | MAIN | DEFAULT } ] [ COMPRESSION <replaceable>compression_method</replaceable> ] [ COLLATE <replaceable>collation</replaceable> ] [ <replaceable class="parameter">column_constraint</replaceable> [ ... ] ]
    | <replaceable>table_constraint</replaceable>
    | LIKE <replaceable>source_table</replaceable> [ <replaceable>like_option</replaceable> ... ] }
    [, ... ]
] )
[ INHERITS ( <replaceable>parent_table</replaceable> [, ... ] ) ]
[ PARTITION BY { RANGE | LIST | HASH } ( { <replaceable class="parameter">column_name</replaceable> | ( <replaceable class="parameter">expression</replaceable> ) } [ COLLATE <replaceable class="parameter">collation</replaceable> ] [ <replaceable class="parameter">opclass</replaceable> ] [, ... ] ) ]
[ USING <replaceable class="parameter">method</replaceable> ]
[ WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] ) | WITHOUT OIDS ]
[ ON COMMIT { PRESERVE ROWS | DELETE ROWS | DROP } ]
[ TABLESPACE <replaceable class="parameter">tablespace_name</replaceable> ]

CREATE [ [ GLOBAL | LOCAL ] { TEMPORARY | TEMP } | UNLOGGED ] TABLE [ IF NOT EXISTS ] <replaceable class="parameter">table_name</replaceable>
    OF <replaceable class="parameter">type_name</replaceable> [ (
  { <replaceable class="parameter">column_name</replaceable> [ WITH OPTIONS ] [ <replaceable class="parameter">column_constraint</replaceable> [ ... ] ]
    | <replaceable>table_constraint</replaceable> }
    [, ... ]
) ]
[ PARTITION BY { RANGE | LIST | HASH } ( { <replaceable class="parameter">column_name</replaceable> | ( <replaceable class="parameter">expression</replaceable> ) } [ COLLATE <replaceable class="parameter">collation</replaceable> ] [ <replaceable class="parameter">opclass</replaceable> ] [, ... ] ) ]
[ USING <replaceable class="parameter">method</replaceable> ]
[ WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] ) | WITHOUT OIDS ]
[ ON COMMIT { PRESERVE ROWS | DELETE ROWS | DROP } ]
[ TABLESPACE <replaceable class="parameter">tablespace_name</replaceable> ]

CREATE [ [ GLOBAL | LOCAL ] { TEMPORARY | TEMP } | UNLOGGED ] TABLE [ IF NOT EXISTS ] <replaceable class="parameter">table_name</replaceable>
    PARTITION OF <replaceable class="parameter">parent_table</replaceable> [ (
  { <replaceable class="parameter">column_name</replaceable> [ WITH OPTIONS ] [ <replaceable class="parameter">column_constraint</replaceable> [ ... ] ]
    | <replaceable>table_constraint</replaceable> }
    [, ... ]
) ] { FOR VALUES <replaceable class="parameter">partition_bound_spec</replaceable> | DEFAULT }
[ PARTITION BY { RANGE | LIST | HASH } ( { <replaceable class="parameter">column_name</replaceable> | ( <replaceable class="parameter">expression</replaceable> ) } [ COLLATE <replaceable class="parameter">collation</replaceable> ] [ <replaceable class="parameter">opclass</replaceable> ] [, ... ] ) ]
[ USING <replaceable class="parameter">method</replaceable> ]
[ WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] ) | WITHOUT OIDS ]
[ ON COMMIT { PRESERVE ROWS | DELETE ROWS | DROP } ]
[ TABLESPACE <replaceable class="parameter">tablespace_name</replaceable> ]

<phrase>where <replaceable class="parameter">column_constraint</replaceable> is:</phrase>

[ CONSTRAINT <replaceable class="parameter">constraint_name</replaceable> ]
{ NOT NULL [ NO INHERIT ]  |
  NULL |
  CHECK ( <replaceable class="parameter">expression</replaceable> ) [ NO INHERIT ] |
  DEFAULT <replaceable>default_expr</replaceable> |
  GENERATED ALWAYS AS ( <replaceable>generation_expr</replaceable> ) [ STORED | VIRTUAL ] |
  GENERATED { ALWAYS | BY DEFAULT } AS IDENTITY [ ( <replaceable>sequence_options</replaceable> ) ] |
  UNIQUE [ NULLS [ NOT ] DISTINCT ] <replaceable class="parameter">index_parameters</replaceable> |
  PRIMARY KEY <replaceable class="parameter">index_parameters</replaceable> |
  REFERENCES <replaceable class="parameter">reftable</replaceable> [ ( <replaceable class="parameter">refcolumn</replaceable> ) ] [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
    [ ON DELETE <replaceable class="parameter">referential_action</replaceable> ] [ ON UPDATE <replaceable class="parameter">referential_action</replaceable> ] }
[ DEFERRABLE | NOT DEFERRABLE ] [ INITIALLY DEFERRED | INITIALLY IMMEDIATE ] [ ENFORCED | NOT ENFORCED ]

<phrase>and <replaceable class="parameter">table_constraint</replaceable> is:</phrase>

[ CONSTRAINT <replaceable class="parameter">constraint_name</replaceable> ]
{ CHECK ( <replaceable class="parameter">expression</replaceable> ) [ NO INHERIT ] |
  NOT NULL <replaceable class="parameter">column_name</replaceable> [ NO INHERIT ] |
  UNIQUE [ NULLS [ NOT ] DISTINCT ] ( <replaceable class="parameter">column_name</replaceable> [, ... ] [, <replaceable class="parameter">column_name</replaceable> WITHOUT OVERLAPS ] ) <replaceable class="parameter">index_parameters</replaceable> |
  PRIMARY KEY ( <replaceable class="parameter">column_name</replaceable> [, ... ] [, <replaceable class="parameter">column_name</replaceable> WITHOUT OVERLAPS ] ) <replaceable class="parameter">index_parameters</replaceable> |
  EXCLUDE [ USING <replaceable class="parameter">index_method</replaceable> ] ( <replaceable class="parameter">exclude_element</replaceable> WITH <replaceable class="parameter">operator</replaceable> [, ... ] ) <replaceable class="parameter">index_parameters</replaceable> [ WHERE ( <replaceable class="parameter">predicate</replaceable> ) ] |
  FOREIGN KEY ( <replaceable class="parameter">column_name</replaceable> [, ... ] [, PERIOD <replaceable class="parameter">column_name</replaceable> ] ) REFERENCES <replaceable class="parameter">reftable</replaceable> [ ( <replaceable class="parameter">refcolumn</replaceable> [, ... ] [, PERIOD <replaceable class="parameter">refcolumn</replaceable> ] ) ]
    [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ] [ ON DELETE <replaceable
class="parameter">referential_action</replaceable> ] [ ON UPDATE <replaceable class="parameter">referential_action</replaceable> ] }
[ DEFERRABLE | NOT DEFERRABLE ] [ INITIALLY DEFERRED | INITIALLY IMMEDIATE ] [ ENFORCED | NOT ENFORCED ]

<phrase>and <replaceable class="parameter">like_option</replaceable> is:</phrase>

{ INCLUDING | EXCLUDING } { COMMENTS | COMPRESSION | CONSTRAINTS | DEFAULTS | GENERATED | IDENTITY | INDEXES | STATISTICS | STORAGE | ALL }

<phrase>and <replaceable class="parameter">partition_bound_spec</replaceable> is:</phrase>

IN ( <replaceable class="parameter">partition_bound_expr</replaceable> [, ...] ) |
FROM ( { <replaceable class="parameter">partition_bound_expr</replaceable> | MINVALUE | MAXVALUE } [, ...] )
  TO ( { <replaceable class="parameter">partition_bound_expr</replaceable> | MINVALUE | MAXVALUE } [, ...] ) |
WITH ( MODULUS <replaceable class="parameter">numeric_literal</replaceable>, REMAINDER <replaceable class="parameter">numeric_literal</replaceable> )

<phrase><replaceable class="parameter">index_parameters</replaceable> in <literal>UNIQUE</literal>, <literal>PRIMARY KEY</literal>, and <literal>EXCLUDE</literal> constraints are:</phrase>

[ INCLUDE ( <replaceable class="parameter">column_name</replaceable> [, ... ] ) ]
[ WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] ) ]
[ USING INDEX TABLESPACE <replaceable class="parameter">tablespace_name</replaceable> ]

<phrase><replaceable class="parameter">exclude_element</replaceable> in an <literal>EXCLUDE</literal> constraint is:</phrase>

{ <replaceable class="parameter">column_name</replaceable> | ( <replaceable class="parameter">expression</replaceable> ) } [ COLLATE <replaceable class="parameter">collation</replaceable> ] [ <replaceable class="parameter">opclass</replaceable> [ ( <replaceable class="parameter">opclass_parameter</replaceable> = <replaceable class="parameter">value</replaceable> [, ... ] ) ] ] [ ASC | DESC ] [ NULLS { FIRST | LAST } ]

<phrase><replaceable class="parameter">referential_action</replaceable> in a <literal>FOREIGN KEY</literal>/<literal>REFERENCES</literal> constraint is:</phrase>

{ NO ACTION | RESTRICT | CASCADE | SET NULL [ ( <replaceable class="parameter">column_name</replaceable> [, ... ] ) ] | SET DEFAULT [ ( <replaceable class="parameter">column_name</replaceable> [, ... ] ) ] }
</synopsis>

 </refsynopsisdiv>

 <refsect1 id="sql-createtable-description">
  <title>描述</title>

  <para>
   <command>CREATE TABLE</command> 将在当前数据库中创建一个新的、初始为空的表。该表将由发出该命令的用户拥有。
  </para>

  <para>
   如果给定了模式名（例如 <literal>CREATE TABLE
   myschema.mytable ...</literal>），则该表在指定的模式中创建。否则在当前模式中创建。临时表存在于一个特殊的模式中，因此在创建临时表时不能指定模式名。表名必须与同一模式中任何其他关系（表、序列、索引、视图、物化视图或外部表）的名称不同。
  </para>

  <para>
   <command>CREATE TABLE</command> 还会自动创建一个数据类型，表示与该表的一行相对应的复合类型。因此，表不能与同一模式中任何现有数据类型同名。
  </para>

  <para>
   可选的约束子句指定约束（测试），新行或更新后的行必须满足这些约束，插入或更新操作才能成功。约束是一种 SQL 对象，它以多种方式帮助定义表中的有效值集合。
  </para>

  <para>
   定义约束有两种方式：表约束和列约束。列约束定义为列定义的一部分。表约束定义不绑定到特定列，并且可以涵盖多个列。每个列约束也可以写成表约束；列约束只是一种记法上的便利，用于约束只影响一列的情况。
  </para>

  <para>
   要能够创建表，你必须分别拥有所有列类型或 <literal>OF</literal> 子句中类型的 <literal>USAGE</literal> 权限。
  </para>
 </refsect1>

 <refsect1>
  <title>参数</title>

  <variablelist>

   <varlistentry id="sql-createtable-temporary">
    <term><literal>TEMPORARY</literal> 或 <literal>TEMP</literal></term>
    <listitem>
     <para>
      如果指定，则表被创建为临时表。临时表在会话结束时自动删除，或者可选地在当前事务结束时删除（见下文 <literal>ON COMMIT</literal>）。默认的 search_path 首先包含临时模式，因此当临时表存在时，同名的现有永久表不会被选用于新计划，除非它们以模式限定名引用。在临时表上创建的任何索引也自动为临时索引。
     </para>

     <para>
      <link linkend="autovacuum">自动清理守护进程</link>无法访问临时表，因此无法对临时表执行 vacuum 或 analyze。因此，应通过会话 SQL 命令执行适当的 vacuum 和 analyze 操作。例如，如果临时表将用于复杂查询，明智的做法是在填充临时表后对其运行 <command>ANALYZE</command>。
     </para>

     <para>
      可选地，<literal>GLOBAL</literal> 或 <literal>LOCAL</literal> 可以写在 <literal>TEMPORARY</literal> 或 <literal>TEMP</literal> 之前。目前在 <productname>PostgreSQL</productname> 中这没有区别，并且已被废弃；参见下面的 <xref linkend="sql-createtable-compatibility"/>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-unlogged">
    <term><literal>UNLOGGED</literal></term>
    <listitem>
     <para>
      如果指定了此选项，表将创建为不记录日志的表。写入不记录日志的表的数据不会写入预写式日志（参见 <xref
      linkend="wal"/>），这使得它们比普通表快得多。但是，它们不是崩溃安全的：在崩溃或非正常关闭后，不记录日志的表会被自动截断。不记录日志的表内容也不会复制到备用服务器。在不记录日志的表上创建的任何索引也会自动成为不记录日志的索引。
     </para>

     <para>
      如果指定了这一点，则随不记录日志的表一起创建的任何序列（用于标识列或 serial 列）也会被创建为不记录日志的序列。
     </para>

     <para>
      分区表不支持这种形式。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-if-not-exists">
    <term><literal>IF NOT EXISTS</literal></term>
    <listitem>
     <para>
      如果同名关系已经存在，不要抛出错误。在这种情况下会发出一个提示。请注意，不保证现有关系与将要创建的关系有任何相似之处。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-table-name">
    <term><replaceable class="parameter">table_name</replaceable></term>
    <listitem>
     <para>
      要创建的表的名称（可以选择用模式限定）。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-type-name">
    <term><literal>OF <replaceable class="parameter">type_name</replaceable></literal></term>
    <listitem>
     <para>
      创建一个<firstterm>类型化表</firstterm>，其结构取自指定的独立复合类型（即使用 <xref linkend="sql-createtype"/> 创建的类型），不过它同时也会产生一个新的复合类型。该表将依赖于所引用的类型，这意味着对该类型的级联 ALTER 和 DROP 操作将传播到该表。
     </para>

     <para>
      类型化表始终具有与其派生自的类型相同的列名和数据类型，因此不能指定额外的列。但是 <literal>CREATE TABLE</literal> 命令可以向表中添加默认值和约束，也可以指定存储参数。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-column-name">
    <term><replaceable class="parameter">column_name</replaceable></term>
    <listitem>
     <para>
      要在新表中创建的列的名称。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-data-type">
    <term><replaceable class="parameter">data_type</replaceable></term>
    <listitem>
     <para>
      列的数据类型。可以包含数组说明符。有关 <productname>PostgreSQL</productname> 支持的数据类型的更多信息，请参阅 <xref
      linkend="datatype"/>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-collate">
    <term><literal>COLLATE <replaceable>collation</replaceable></literal></term>
    <listitem>
     <para>
      <literal>COLLATE</literal> 子句为列指定排序规则（该列必须是可排序的数据类型）。如果未指定，则使用列数据类型的默认排序规则。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-storage">
    <term>
     <literal>STORAGE { PLAIN | EXTERNAL | EXTENDED | MAIN | DEFAULT }</literal>
     <indexterm>
      <primary>TOAST</primary>
      <secondary>逐列存储设置</secondary>
     </indexterm>
    </term>
    <listitem>
     <para>
      这种形式设置列的存储模式。它控制该列是内联保存还是保存在辅助 <acronym>TOAST</acronym> 表中，以及数据是否应该被压缩。对于像 <type>integer</type> 这样的定长值必须使用 <literal>PLAIN</literal>，它是内联、未压缩的。<literal>MAIN</literal> 用于内联、可压缩的数据。<literal>EXTERNAL</literal> 用于外部、未压缩的数据，<literal>EXTENDED</literal> 用于外部、压缩的数据。写 <literal>DEFAULT</literal> 会将存储模式设置为该列数据类型的默认模式。对于大多数支持非 <literal>PLAIN</literal> 存储的数据类型，<literal>EXTENDED</literal> 是默认值。使用 <literal>EXTERNAL</literal> 可以使对非常大的 <type>text</type> 和 <type>bytea</type> 值的子串操作运行得更快，代价是增加存储空间。更多信息请参见 <xref linkend="storage-toast"/>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-compression">
    <term><literal>COMPRESSION <replaceable class="parameter">compression_method</replaceable></literal></term>
    <listitem>
     <para>
      <literal>COMPRESSION</literal> 子句设置列的压缩方法。只有变长数据类型才支持压缩，并且仅当列的存储模式为 <literal>main</literal> 或 <literal>extended</literal> 时才会使用。（有关列存储模式的信息，请参见 <xref linkend="sql-altertable"/>。）为分区表设置此属性没有直接影响，因为此类表没有自己的存储，但配置的值将被新建的分区继承。支持的压缩方法有 <literal>pglz</literal> 和 <literal>lz4</literal>。（仅当构建 <productname>PostgreSQL</productname> 时使用了 <option>--with-lz4</option>，<literal>lz4</literal> 才可用。）此外，<replaceable class="parameter">compression_method</replaceable> 可以是 <literal>default</literal>，以显式指定默认行为，即在插入数据时参考 <xref linkend="guc-default-toast-compression"/> 设置来确定要使用的方法。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-inherits">
    <term><literal>INHERITS ( <replaceable>parent_table</replaceable> [, ... ] )</literal></term>
    <listitem>
     <para>
      可选的 <literal>INHERITS</literal> 子句指定一个表列表，新表将自动从这些表继承所有列。父表可以是普通表或外部表。
     </para>

     <para>
      使用 <literal>INHERITS</literal> 会在新的子表与其父表之间创建持久关系。对父表的模式修改通常也会传播到子表，并且默认情况下，子表的数据会包含在父表的扫描中。
     </para>

     <para>
      如果同一个列名出现在多个父表中，则会报告错误，除非每个父表中该列的数据类型都匹配。如果没有冲突，则重复的列会被合并，在新表中形成单个列。如果新表的列名列表中包含一个同时也是继承而来的列名，则该列的数据类型同样必须与被继承的列匹配，并且列定义会合并为一个。如果新表为该列显式指定了默认值，则该默认值会覆盖该列继承声明中的任何默认值。否则，所有为该列指定了默认值的父表都必须指定相同的默认值，否则将报告错误。
     </para>

     <para>
      <literal>CHECK</literal> 约束的合并方式与列基本相同：如果多个父表和/或新表定义中包含同名的 <literal>CHECK</literal> 约束，则这些约束必须都具有相同的检查表达式，否则将报告错误。名称和表达式都相同的约束会合并为一份副本。在父表中标记为 <literal>NO INHERIT</literal> 的约束不会被考虑。请注意，新表中未命名的 <literal>CHECK</literal> 约束永远不会被合并，因为总会为它选择一个唯一的名称。
     </para>

     <para>
      列的 <literal>STORAGE</literal> 设置也会从父表复制。
     </para>

     <para>
      如果父表中的某一列是标识列，则该属性不会被继承。子表中的列可以根据需要声明为标识列。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-partition-by">
    <term><literal>PARTITION BY { RANGE | LIST | HASH } ( { <replaceable class="parameter">column_name</replaceable> | ( <replaceable class="parameter">expression</replaceable> ) } [ <replaceable class="parameter">opclass</replaceable> ] [, ...] ) </literal></term>
    <listitem>
     <para>
      可选的 <literal>PARTITION BY</literal> 子句指定对表进行分区的策略。这样创建的表称为<firstterm>分区</firstterm>表。括号中的列或表达式列表构成该表的<firstterm>分区键</firstterm>。使用范围分区或哈希分区时，分区键可以包含多个列或表达式（最多 32 个，但在构建 <productname>PostgreSQL</productname> 时可以更改此限制），但对于列表分区，分区键必须由单个列或表达式组成。
     </para>

     <para>
      范围分区和列表分区要求使用 btree 运算符类，而哈希分区要求使用哈希运算符类。如果没有显式指定运算符类，将使用相应类型的默认运算符类；如果不存在默认运算符类，则会报错。使用哈希分区时，所用的运算符类必须实现支持函数 2（详见 <xref linkend="xindex-support"/>）。
     </para>

     <para>
      分区表被划分为子表（称为分区），这些子表使用单独的 <literal>CREATE TABLE</literal> 命令创建。分区表本身是空的。插入到表中的数据行会根据分区键中列或表达式的值被路由到某个分区。如果没有任何现有分区与新行中的值匹配，则会报告错误。
     </para>

     <para>
      关于表分区的更多讨论，请参见 <xref linkend="ddl-partitioning"/>。
     </para>

    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-partition">
    <term><literal>PARTITION OF <replaceable class="parameter">parent_table</replaceable> { FOR VALUES <replaceable class="parameter">partition_bound_spec</replaceable> | DEFAULT }</literal></term>
    <listitem>
     <para>
      将表创建为指定父表的<firstterm>分区</firstterm>。该表既可以使用 <literal>FOR VALUES</literal> 创建为针对特定值的分区，也可以使用 <literal>DEFAULT</literal> 创建为默认分区。父表中存在的任何索引、约束和用户定义的行级触发器都会克隆到新分区上。
     </para>

     <para>
      <replaceable class="parameter">partition_bound_spec</replaceable> 必须与父表的分区方法和分区键相对应，并且不能与该父表的任何现有分区重叠。带有 <literal>IN</literal> 的形式用于列表分区，带有 <literal>FROM</literal> 和 <literal>TO</literal> 的形式用于范围分区，带有 <literal>WITH</literal> 的形式用于哈希分区。
     </para>

     <para>
      <replaceable class="parameter">partition_bound_expr</replaceable> 是任何不含变量的表达式（不允许子查询、窗口函数、聚合函数和集合返回函数）。其数据类型必须与相应分区键列的数据类型匹配。该表达式在创建表时求值一次，因此甚至可以包含诸如 <literal><function>CURRENT_TIMESTAMP</function></literal> 之类的易变表达式。
     </para>

     <para>
      创建列表分区时，可以指定 <literal>NULL</literal> 来表示该分区允许分区键列为空值。不过，对于给定的父表，这样的列表分区不能多于一个。范围分区不能指定 <literal>NULL</literal>。
     </para>

     <para>
      创建范围分区时，用 <literal>FROM</literal> 指定的下界是包含边界，而用 <literal>TO</literal> 指定的上界是不包含边界。也就是说，<literal>FROM</literal> 列表中指定的值是此分区对应分区键列的有效值，而 <literal>TO</literal> 列表中的值则不是。请注意，必须按照行比较的规则（<xref linkend="row-wise-comparison"/>）来理解这一说法。例如，给定 <literal>PARTITION BY RANGE (x,y)</literal>，分区边界 <literal>FROM (1, 2) TO (3, 4)</literal> 允许 <literal>x=1</literal> 取任意 <literal>y&gt;=2</literal>、<literal>x=2</literal> 取任意非空 <literal>y</literal>，以及 <literal>x=3</literal> 取任意 <literal>y&lt;4</literal>。
     </para>

     <para>
      创建范围分区时，可以使用特殊值 <literal>MINVALUE</literal> 和 <literal>MAXVALUE</literal> 来表示该列的值没有下界或上界。例如，使用 <literal>FROM (MINVALUE) TO (10)</literal> 定义的分区允许任何小于 10 的值，而使用 <literal>FROM (10) TO (MAXVALUE)</literal> 定义的分区允许任何大于或等于 10 的值。
     </para>

     <para>
      创建涉及多个列的范围分区时，将 <literal>MAXVALUE</literal> 用作下界的一部分、将 <literal>MINVALUE</literal> 用作上界的一部分也是有意义的。例如，使用 <literal>FROM (0, MAXVALUE) TO (10, MAXVALUE)</literal> 定义的分区允许第一个分区键列大于 0 且小于或等于 10 的任何行。类似地，使用 <literal>FROM ('a', MINVALUE) TO ('b', MINVALUE)</literal> 定义的分区允许第一个分区键列以 "a" 开头的任何行。
     </para>

     <para>
      请注意，如果对分区边界的某一列使用了 <literal>MINVALUE</literal> 或 <literal>MAXVALUE</literal>，则所有后续列都必须使用相同的值。例如，<literal>(10, MINVALUE, 0)</literal> 不是有效的边界；应该写成 <literal>(10, MINVALUE, MINVALUE)</literal>。
     </para>

     <para>
      另请注意，某些元素类型（例如 <literal>timestamp</literal>）具有“无穷大”的概念，它只是另一种可以存储的值。这与 <literal>MINVALUE</literal> 和 <literal>MAXVALUE</literal> 不同，它们不是可以存储的真实值，而是表示该值无界的方式。可以将 <literal>MAXVALUE</literal> 视为大于任何其他值，包括“无穷大”，而 <literal>MINVALUE</literal> 视为小于任何其他值，包括“负无穷大”。因此范围 <literal>FROM ('infinity') TO (MAXVALUE)</literal> 不是空范围；它恰好允许存储一个值 &mdash;“无穷大”。
     </para>

     <para>
      如果指定了 <literal>DEFAULT</literal>，则该表将被创建为父表的默认分区。此选项不适用于哈希分区表。不适合给定父表任何其他分区的分区键值将被路由到默认分区。
     </para>

     <para>
      当表已有 <literal>DEFAULT</literal> 分区并且向其添加新分区时，必须扫描默认分区以验证它不包含任何本应属于新分区的行。如果默认分区包含大量行，这可能很慢。如果默认分区是外部表，或者它有一个约束证明它不可能包含应放入新分区的行，则将跳过扫描。
     </para>

     <para>
      创建哈希分区时，必须指定模数和余数。模数必须是一个正整数，余数必须是一个小于模数的非负整数。通常，在最初设置哈希分区表时，应选择一个等于分区数的模数，并为每个表分配相同的模数和不同的余数（参见下面的示例）。然而，并不要求每个分区都具有相同的模数，只要求哈希分区表的所有分区中出现的每个模数都是下一个更大模数的因子。这样便可以在无需一次性移动所有数据的情况下逐步增加分区数。例如，假设你有一个包含 8 个分区的哈希分区表，每个分区的模数均为 8，但发现有必要将分区数增加到 16。你可以分离其中一个模数为 8 的分区，创建两个新的模数为 16 的分区来覆盖键空间的同一部分（一个分区的余数等于被分离分区的余数，另一个分区的余数等于该值加 8），并重新填充数据。然后，你可以对每个模数为 8 的分区重复此操作——或许在稍后的时间——直到不再有此类分区为止。尽管这在每一步中仍可能涉及大量数据移动，但仍比不得不创建全新表并一次性移动所有数据要好。
     </para>

     <para>
      分区必须与其所属的分区表具有相同的列名和类型。对分区表的列名或类型的修改将自动传播到所有分区。<literal>CHECK</literal> 约束将由每个分区自动继承，但单个分区可以指定额外的 <literal>CHECK</literal> 约束；与父表中名称和条件相同的额外约束将与父约束合并。可以为每个分区单独指定默认值。但请注意，通过分区表插入元组时，分区的默认值不会被应用。
     </para>

     <para>
      插入到分区表中的行将自动路由到正确的分区。如果不存在合适的分区，将发生错误。
     </para>

     <para>
      诸如 <command>TRUNCATE</command> 之类的操作通常会影响一个表及其所有继承子表，这类操作会级联到所有分区，但也可以对单个分区执行。
     </para>

     <para>
      注意，使用 <literal>PARTITION OF</literal> 创建分区需要在父分区表上取得 <literal>ACCESS EXCLUSIVE</literal> 锁。同样，使用 <command>DROP TABLE</command> 删除分区需要在父表上取得 <literal>ACCESS EXCLUSIVE</literal> 锁。可以使用 <link linkend="sql-altertable"><command>ALTER
      TABLE ATTACH/DETACH PARTITION</command></link> 以较弱的锁执行这些操作，从而减少对分区表上并发操作的干扰。
     </para>

    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-like">
    <term><literal>LIKE <replaceable>source_table</replaceable> [ <replaceable>like_option</replaceable> ... ]</literal></term>
    <listitem>
     <para>
      <literal>LIKE</literal> 子句指定一个表，新表会自动从该表复制所有列名、其数据类型及其非空约束。
     </para>
     <para>
      与 <literal>INHERITS</literal> 不同，创建完成后新表与原表完全解耦。对原表的更改不会应用到新表，并且无法在对原表的扫描中包含新表的数据。
     </para>
      <para>
      同样与 <literal>INHERITS</literal> 不同，由 <literal>LIKE</literal> 复制的列和约束不会与同名的列和约束合并。如果显式指定了相同的名称，或在另一个 <literal>LIKE</literal> 子句中指定了相同的名称，则会报错。
     </para>
     <para>
      可选的 <replaceable>like_option</replaceable> 子句指定要复制原表的哪些附加属性。指定 <literal>INCLUDING</literal> 会复制该属性，指定 <literal>EXCLUDING</literal> 会省略该属性。<literal>EXCLUDING</literal> 是默认值。如果对同一类对象做了多次指定，则使用最后一个。可用的选项有：

      <variablelist>
       <varlistentry id="sql-createtable-parms-like-opt-comments">
        <term><literal>INCLUDING COMMENTS</literal></term>
        <listitem>
         <para>
          被复制列、检查约束、非空约束、索引和扩展统计信息的注释将被复制。默认行为是排除注释，这会导致新表中的对应对象没有注释。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-compression">
        <term><literal>INCLUDING COMPRESSION</literal></term>
        <listitem>
         <para>
          列的压缩方法将被复制。默认行为是排除压缩方法，这会导致列具有默认压缩方法。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-constraints">
        <term><literal>INCLUDING CONSTRAINTS</literal></term>
        <listitem>
         <para>
          <literal>CHECK</literal> 约束将被复制。不区分列约束和表约束。非空约束总是被复制到新表。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-defaults">
        <term><literal>INCLUDING DEFAULTS</literal></term>
        <listitem>
         <para>
          被复制列定义的默认表达式将被复制。否则，默认表达式不会被复制，这会导致新表中被复制的列具有空默认值。注意，复制调用数据库修改函数的默认值（例如 <function>nextval</function>）可能会在原始表和新表之间创建功能关联。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-generated">
        <term><literal>INCLUDING GENERATED</literal></term>
        <listitem>
         <para>
          任何生成表达式以及被复制列定义的存储/虚拟选择都将被复制。默认情况下，新列将是常规基础列。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-identity">
        <term><literal>INCLUDING IDENTITY</literal></term>
        <listitem>
         <para>
          被复制列定义的任何标识规范都将被复制。将为新表的每个标识列创建一个新序列，与旧表关联的序列相互独立。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-indexes">
        <term><literal>INCLUDING INDEXES</literal></term>
        <listitem>
         <para>
          原表上的索引、<literal>PRIMARY KEY</literal>、<literal>UNIQUE</literal> 和 <literal>EXCLUDE</literal> 约束将在新表上创建。新索引和约束的名称按照默认规则选择，而不管原名称是如何命名的。（此行为可避免新索引可能出现的重名失败。）
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-statistics">
        <term><literal>INCLUDING STATISTICS</literal></term>
        <listitem>
         <para>
          扩展统计信息会被复制到新表。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-storage">
        <term><literal>INCLUDING STORAGE</literal></term>
        <listitem>
         <para>
          被复制列定义的 <literal>STORAGE</literal> 设置将被复制。默认行为是排除 <literal>STORAGE</literal> 设置，这会导致新表中被复制的列具有类型特定的默认设置。有关 <literal>STORAGE</literal> 设置的更多信息，请参见 <xref
          linkend="storage-toast"/>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-like-opt-all">
        <term><literal>INCLUDING ALL</literal></term>
        <listitem>
         <para>
          <literal>INCLUDING ALL</literal> 是一种简写形式，用于选择所有可用的单独选项。（在 <literal>INCLUDING ALL</literal> 之后写出单独的 <literal>EXCLUDING</literal> 子句以选择除某些特定选项之外的所有选项，可能会很有用。）
         </para>
        </listitem>
       </varlistentry>
      </variablelist>
     </para>

     <para>
      <literal>LIKE</literal> 子句也可以用于从视图、外部表或复合类型复制列定义。不适用的选项（例如来自视图的 <literal>INCLUDING INDEXES</literal>）会被忽略。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-constraint">
    <term><literal>CONSTRAINT <replaceable class="parameter">constraint_name</replaceable></literal></term>
    <listitem>
     <para>
      列约束或表约束的可选名称。如果违反了该约束，错误消息中会包含约束名称，因此像 <literal>col must be positive</literal> 这样的约束名称可用于向客户端应用程序传达有用的约束信息。（指定包含空格的约束名称需要使用双引号。）如果未指定约束名称，系统会生成一个名称。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-not-null">
    <term><literal>NOT NULL [ NO INHERIT ] </literal></term>
    <listitem>
     <para>
      该列不允许包含空值。
     </para>

     <para>
      用 <literal>NO INHERIT</literal> 标记的约束不会传播到子表。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-null">
    <term><literal>NULL</literal></term>
    <listitem>
     <para>
      该列允许包含空值。这是默认值。
     </para>

     <para>
      提供此子句只是为了与非标准 SQL 数据库兼容。在新的应用中不鼓励使用它。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-check">
    <term><literal>CHECK ( <replaceable class="parameter">expression</replaceable> ) [ NO INHERIT ] </literal></term>
    <listitem>
     <para>
      <literal>CHECK</literal> 子句指定一个产生布尔结果的表达式，插入或更新操作要成功，新行或更新后的行必须满足该表达式。求值为 TRUE 或 UNKNOWN 的表达式会成功。如果插入或更新操作的任何一行产生 FALSE 结果，就会引发错误异常，并且该插入或更新不会更改数据库。作为列约束指定的检查约束应只引用该列的值，而出现在表约束中的表达式可以引用多个列。
     </para>

     <para>
      目前，<literal>CHECK</literal> 表达式不能包含子查询，也不能引用当前行的列以外的变量（参见 <xref linkend="ddl-constraints-check-constraints"/>）。可以引用系统列 <literal>tableoid</literal>，但不能引用任何其他系统列。
     </para>

     <para>
      用 <literal>NO INHERIT</literal> 标记的约束不会传播到子表。
     </para>

     <para>
      当一个表有多个 <literal>CHECK</literal> 约束时，在检查完 <literal>NOT NULL</literal> 约束之后，将按名称的字母顺序对每一行依次测试它们。
      （9.5 之前的 <productname>PostgreSQL</productname> 版本不遵循 <literal>CHECK</literal> 约束的任何特定触发顺序。）
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-default">
    <term><literal>DEFAULT
    <replaceable>default_expr</replaceable></literal></term>
    <listitem>
     <para>
      <literal>DEFAULT</literal> 子句为它所在的列定义所对应的列指定一个默认数据值。该值可以是任何不含变量的表达式（特别地，不允许引用当前表中的其他列）。也不允许使用子查询。默认表达式的数据类型必须与列的数据类型相匹配。
     </para>

     <para>
      默认表达式将用于任何未为该列指定值的插入操作。如果某列没有默认值，则默认值为 null。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-generated-stored">
    <term><literal>GENERATED ALWAYS AS ( <replaceable>generation_expr</replaceable> ) [ STORED | VIRTUAL ]</literal><indexterm><primary>生成列</primary></indexterm></term>
    <listitem>
     <para>
      该子句将该列创建为<firstterm>生成列</firstterm>。不能向该列写入数据，读取时将返回指定表达式的结果。
     </para>

     <para>
      当指定 <literal>VIRTUAL</literal> 时，该列将在读取时计算，并且不占用任何存储。当指定 <literal>STORED</literal> 时，该列将在写入时计算并存储在磁盘上。<literal>VIRTUAL</literal> 是默认值。
     </para>

     <para>
      生成表达式可以引用表中的其他列，但不能引用其他生成列。所使用的任何函数和运算符都必须是不可变的。不允许引用其他表。
     </para>

     <para>
      虚拟生成列不能具有用户定义类型，并且虚拟生成列的生成表达式不得引用用户定义的函数或类型，也就是说，它只能使用内置函数或类型。这也间接适用，例如对于作为运算符或类型转换基础的那些函数或类型。（存储生成列不存在此限制。）
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-generated-identity">
    <term><literal>GENERATED { ALWAYS | BY DEFAULT } AS IDENTITY [ ( <replaceable>sequence_options</replaceable> ) ]</literal></term>
    <listitem>
     <para>
      此子句将该列创建为 <firstterm>标识列</firstterm>。它将附带一个隐式序列，并且在新插入的行中，该列将自动被赋予来自该序列的值。这样的列隐式为 <literal>NOT NULL</literal>。
     </para>

     <para>
      子句 <literal>ALWAYS</literal> 和 <literal>BY DEFAULT</literal> 决定在 <command>INSERT</command> 和 <command>UPDATE</command> 命令中如何处理用户显式指定的值。
     </para>

     <para>
      在 <command>INSERT</command> 命令中，如果选择了 <literal>ALWAYS</literal>，则只有当 <command>INSERT</command> 语句指定了 <literal>OVERRIDING SYSTEM
      VALUE</literal> 时才接受用户指定的值。如果选择了 <literal>BY DEFAULT</literal>，则用户指定的值优先。详见 <xref linkend="sql-insert"/>。（在 <command>COPY</command> 命令中，无论此设置如何，始终使用用户指定的值。）
     </para>

     <para>
      在 <command>UPDATE</command> 命令中，如果选择了 <literal>ALWAYS</literal>，则将该列更新为 <literal>DEFAULT</literal> 以外的任何值都将被拒绝。如果选择了 <literal>BY
      DEFAULT</literal>，则该列可以正常更新。（<command>UPDATE</command> 命令没有 <literal>OVERRIDING</literal> 子句。）
     </para>

     <para>
      可选的 <replaceable>sequence_options</replaceable> 子句可用于覆盖序列的参数。可用的选项包括 <xref linkend="sql-createsequence"/> 中所示的那些，外加 <literal>SEQUENCE NAME <replaceable>name</replaceable></literal>、<literal>LOGGED</literal> 和 <literal>UNLOGGED</literal>，它们允许选择序列的名称和持久化级别。如果没有 <literal>SEQUENCE NAME</literal>，系统会为序列选择一个未使用的名称。如果没有 <literal>LOGGED</literal> 或 <literal>UNLOGGED</literal>，序列将具有与表相同的持久化级别。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-unique">
    <term><literal>UNIQUE [ NULLS [ NOT ] DISTINCT ]</literal>（列约束）</term>
    <term><literal>UNIQUE [ NULLS [ NOT ] DISTINCT ] ( <replaceable class="parameter">column_name</replaceable> [, ... ] [, <replaceable class="parameter">column_name</replaceable> WITHOUT OVERLAPS ] )</literal>
    <optional> <literal>INCLUDE ( <replaceable class="parameter">column_name</replaceable> [, ...])</literal> </optional>（表约束）</term>

    <listitem>
     <para>
      <literal>UNIQUE</literal> 约束指定表的一组或多列只能包含唯一值。唯一表约束的行为与唯一列约束相同，只是额外具备跨多列的能力。因此，该约束强制任意两行必须在这些列中的至少一列上不同。
     </para>

     <para>
      如果为最后一列指定了 <literal>WITHOUT OVERLAPS</literal> 选项，则对该列检查重叠而不是相等。在这种情况下，只要重复项在 <literal>WITHOUT OVERLAPS</literal> 列上不重叠，约束的其他列就允许重复。（如果该列是日期或时间戳范围，这有时称为时间键，但 <productname>PostgreSQL</productname> 允许基于任何基础类型的范围。）实际上，此类约束是通过 <literal>EXCLUDE</literal> 约束而非 <literal>UNIQUE</literal> 约束来实施的。因此，例如 <literal>UNIQUE (id, valid_at WITHOUT OVERLAPS)</literal> 的行为类似于 <literal>EXCLUDE USING GIST (id WITH =, valid_at WITH
      &amp;&amp;)</literal>。<literal>WITHOUT OVERLAPS</literal> 列必须具有范围或多范围类型。不允许空范围/多范围。约束中非 <literal>WITHOUT OVERLAPS</literal> 的列可以是任何能在 GiST 索引中进行相等比较的类型。默认情况下，仅支持范围类型，但你可以通过添加 <xref linkend="btree-gist"/> 扩展来使用其他类型（这是使用此功能的预期方式）。
     </para>

     <para>
      就唯一约束而言，空值不被视为相等，除非指定了 <literal>NULLS NOT DISTINCT</literal>。
     </para>

     <para>
      每个唯一约束所指定的列集合，应当不同于为该表定义的任何其他唯一约束或主键约束所指定的列集合。（否则，冗余的唯一约束将被丢弃。）
     </para>

     <para>
      在为多级分区层次结构建立唯一约束时，目标分区表的分区键中的所有列，以及其所有后代分区表的分区键中的所有列，都必须包含在约束定义中。
     </para>

     <para>
      添加唯一约束将自动在约束所用的列或列组上创建一个唯一 btree 索引。但如果该约束包含 <literal>WITHOUT OVERLAPS</literal> 子句，则会使用 GiST 索引。所创建的索引与唯一约束同名。
     </para>

     <para>
      可选的 <literal>INCLUDE</literal> 子句向该索引添加一个或多个仅作为<quote>负载</quote>的列：不对它们强制唯一性，并且不能基于这些列进行索引搜索。但是可以通过仅索引扫描检索它们。注意，尽管约束不强制作用于包含列，但它仍然依赖于这些列。因此，对此类列的某些操作（例如 <literal>DROP COLUMN</literal>）可能导致级联的约束和索引删除。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-primary-key">
    <term><literal>PRIMARY KEY</literal>（列约束）</term>
    <term><literal>PRIMARY KEY ( <replaceable class="parameter">column_name</replaceable> [, ... ] [, <replaceable class="parameter">column_name</replaceable> WITHOUT OVERLAPS ] )</literal>
    <optional> <literal>INCLUDE ( <replaceable class="parameter">column_name</replaceable> [, ...])</literal> </optional>（表约束）</term>
    <listitem>
     <para>
      <literal>PRIMARY KEY</literal> 约束指定表的一个列或多个列只能包含唯一（不重复）的非空值。一个表只能指定一个主键，无论是作为列约束还是表约束。
     </para>

     <para>
      主键约束所指定的一组列应当不同于为同一表定义的任何唯一约束所指定的列集合。（否则，该唯一约束就是多余的，将被丢弃。）
     </para>

     <para>
      <literal>PRIMARY KEY</literal> 所强制实施的数据约束与 <literal>UNIQUE</literal> 和 <literal>NOT
      NULL</literal> 的组合相同。不过，将一组列标识为主键还提供了有关模式设计的元数据，因为主键意味着其他表可以依赖这组列作为行的唯一标识符。
     </para>

     <para>
      当放置在分区表上时，<literal>PRIMARY KEY</literal> 约束具有前面针对 <literal>UNIQUE</literal> 约束所描述的相同限制。
     </para>

     <para>
      添加 <literal>PRIMARY KEY</literal> 约束会自动在约束所用的列或列组上创建一个唯一 btree 索引；如果指定了 <literal>WITHOUT OVERLAPS</literal>，则创建一个 GiST 索引。
     </para>

     <para>
      可选的 <literal>INCLUDE</literal> 子句向该索引添加一个或多个仅作为<quote>负载</quote>的列：不对它们强制唯一性，并且索引不能基于这些列进行搜索。但是可以通过仅索引扫描检索它们。注意，尽管约束不在包含列上强制实施，但它仍然依赖于这些列。因此，对这些列执行某些操作（例如 <literal>DROP COLUMN</literal>）可能导致级联的约束和索引删除。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-exclude">
    <term><literal>EXCLUDE [ USING <replaceable class="parameter">index_method</replaceable> ] ( <replaceable class="parameter">exclude_element</replaceable> WITH <replaceable class="parameter">operator</replaceable> [, ... ] ) <replaceable class="parameter">index_parameters</replaceable> [ WHERE ( <replaceable class="parameter">predicate</replaceable> ) ]</literal></term>
    <listitem>
     <para>
      <literal>EXCLUDE</literal> 子句定义一个排除约束，它保证如果用指定的运算符在指定的列或表达式上比较任意两行，这些比较不会全部返回 <literal>TRUE</literal>。如果所有指定的运算符都测试相等性，则这等价于一个 <literal>UNIQUE</literal> 约束，尽管普通唯一约束会更快。但是，排除约束可以指定比简单相等更一般的约束。例如，你可以使用 <literal>&amp;&amp;</literal> 运算符指定一个约束，使表中没有两行包含重叠的圆（参见 <xref linkend="datatype-geometric"/>）。运算符要求是可交换的。
     </para>

     <para>
      排除约束使用一个与约束同名的索引实现，因此每个指定的运算符必须与索引访问方法 <replaceable>index_method</replaceable> 的适当运算符类相关联（参见 <xref linkend="indexes-opclass"/>）。每个 <replaceable class="parameter">exclude_element</replaceable> 定义索引的一列，因此它可以选择性地指定排序规则、运算符类、运算符类参数和/或排序选项；这些在 <xref linkend="sql-createindex"/> 下有完整描述。
     </para>

     <para>
      访问方法必须支持 <literal>amgettuple</literal>（参见 <xref
      linkend="indexam"/>）；目前这意味着不能使用
      <acronym>GIN</acronym>。虽然允许在排除约束中使用 B-tree 或哈希索引，但这几乎没有意义，因为普通唯一约束能更好地完成同样的工作。因此，实践中访问方法总是
      <acronym>GiST</acronym> 或 <acronym>SP-GiST</acronym>。
     </para>

     <para>
      <replaceable class="parameter">predicate</replaceable> 允许你在表的子集上指定排除约束；在内部这会创建一个部分索引。注意谓词两边需要加圆括号。
     </para>

     <para>
      在为多级分区层次结构建立排除约束时，目标分区表的分区键中的所有列，以及其所有后代分区表的分区键中的所有列，都必须包含在约束定义中。此外，这些列必须使用等值运算符进行比较。这些限制确保可能冲突的行将存在于同一个分区中。该约束还可以引用不属于任何分区键的其他列，这些列可以使用任何适当的运算符进行比较。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-references">
    <term><literal>REFERENCES <replaceable class="parameter">reftable</replaceable> [ ( <replaceable class="parameter">refcolumn</replaceable> ) ] [ MATCH <replaceable class="parameter">matchtype</replaceable> ] [ ON DELETE <replaceable class="parameter">referential_action</replaceable> ] [ ON UPDATE <replaceable class="parameter">referential_action</replaceable> ]</literal>（列约束）</term>

   <term><literal>FOREIGN KEY ( <replaceable class="parameter">column_name</replaceable> [, ... ] [, PERIOD <replaceable class="parameter">column_name</replaceable> ] )
    REFERENCES <replaceable class="parameter">reftable</replaceable> [ ( <replaceable class="parameter">refcolumn</replaceable> [, ... ] [, PERIOD <replaceable class="parameter">refcolumn</replaceable> ] ) ]
    [ MATCH <replaceable class="parameter">matchtype</replaceable> ]
    [ ON DELETE <replaceable class="parameter">referential_action</replaceable> ]
    [ ON UPDATE <replaceable class="parameter">referential_action</replaceable> ]</literal>
    （表约束）</term>

    <listitem>
     <para>
      这些子句指定一个外键约束，它要求新表中的一组一个或多个列只能包含与引用表中某一行的被引用列的值相匹配的值。如果省略 <replaceable
      class="parameter">refcolumn</replaceable> 列表，则使用 <replaceable class="parameter">reftable</replaceable> 的主键。否则，<replaceable class="parameter">refcolumn</replaceable> 列表必须引用一个不可延迟的唯一约束或主键约束的列，或者是一个非部分唯一索引的列。
     </para>

     <para>
      如果最后一列标记为 <literal>PERIOD</literal>，则以特殊方式处理。非 <literal>PERIOD</literal> 列进行相等比较（并且其中必须至少有一列），而 <literal>PERIOD</literal> 列则不进行比较。相反，如果被引用表具有匹配的记录（基于键的非 <literal>PERIOD</literal> 部分），且这些记录的 <literal>PERIOD</literal> 值组合起来完全覆盖引用记录的值，则认为该约束得到满足。换句话说，该引用在其整个持续时间内必须有一个参照对象。此列必须是范围或多范围类型。此外，被引用表必须声明带有 <literal>WITHOUT
      OVERLAPS</literal> 的主键或唯一约束。最后，如果外键具有 PERIOD <replaceable class="parameter">column_name</replaceable> 规范，则相应的 <replaceable class="parameter">refcolumn</replaceable>（如果存在）也必须标记为 <literal>PERIOD</literal>。如果省略 <replaceable class="parameter">refcolumn</replaceable> 子句，从而选择引用表的主键约束，则主键的最后一列必须标记为 <literal>WITHOUT OVERLAPS</literal>。
     </para>

     <para>
      对于每一对引用列和被引用列，如果它们属于可排序规则的数据类型，则排序规则必须都是确定性的，或者两者相同。这确保两列具有一致的相等性概念。
     </para>

     <para>
      用户必须对被引用的表具有 <literal>REFERENCES</literal> 权限（可以是整个表，也可以是特定的被引用列）。添加外键约束需要被引用表上的 <literal>SHARE ROW EXCLUSIVE</literal> 锁。注意，外键约束不能定义在临时表和永久表之间。
     </para>

     <para>
      插入到引用列中的值会使用给定的匹配类型与被引用表及被引用列的值进行匹配。共有三种匹配类型：<literal>MATCH
      FULL</literal>、<literal>MATCH PARTIAL</literal> 和 <literal>MATCH
      SIMPLE</literal>（后者为默认值）。<literal>MATCH
      FULL</literal> 不允许多列外键中的某一列为空，除非所有外键列都为空；如果它们全为空，则该行不要求在引用表中有匹配行。<literal>MATCH SIMPLE</literal> 允许任意外键列为空；如果其中任何一列为空，则该行不要求在引用表中有匹配行。<literal>MATCH PARTIAL</literal> 尚未实现。（当然，可以对引用列施加 <literal>NOT NULL</literal> 约束来防止出现这些情况。）
     </para>

     <para>
      此外，当被引用列中的数据发生更改时，会对本表各列中的数据执行某些操作。<literal>ON DELETE</literal> 子句指定当被引用表中的被引用行被删除时要执行的操作。同样，<literal>ON UPDATE</literal> 子句指定当被引用表中的被引用列被更新为新值时要执行的操作。如果该行被更新，但被引用列实际上并未更改，则不执行任何操作。引用动作作为数据更改命令的一部分执行，即使约束是延迟的也是如此。每个子句都有以下可能的动作：

      <variablelist>
       <varlistentry id="sql-createtable-parms-references-refact-no-action">
        <term><literal>NO ACTION</literal></term>
        <listitem>
         <para>
          如果删除或更新会创建外键约束违规，则产生一个错误。如果约束是延迟的，那么在约束检查时如果仍然存在任何引用行，就会产生这个错误。这是默认动作。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-references-refact-restrict">
        <term><literal>RESTRICT</literal></term>
        <listitem>
         <para>
          如果要删除或更新的行与被引用表中的行匹配，则产生错误。即使操作后的状态不会违反外键约束，也会阻止该操作。特别是，它阻止将被引用行更新为不同但比较相等的值。（但它不会阻止将列更新为相同值的<quote>空操作</quote>更新。）
         </para>

         <para>
          在时态外键中，不支持此选项。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-references-refact-cascade">
        <term><literal>CASCADE</literal></term>
        <listitem>
         <para>
          删除任何引用被删除行的行，或者分别将引用列的值更新为被引用列的新值。
         </para>

         <para>
          在时态外键中，不支持此选项。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-references-refact-set-null">
        <term><literal>SET NULL [ ( <replaceable>column_name</replaceable> [, ... ] ) ]</literal></term>
        <listitem>
         <para>
          将全部引用列或指定的引用列子集设置为 null。只能为 <literal>ON DELETE</literal> 操作指定列的子集。
         </para>

         <para>
          在时态外键中，不支持此选项。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-references-refact-set-default">
        <term><literal>SET DEFAULT [ ( <replaceable>column_name</replaceable> [, ... ] ) ]</literal></term>
        <listitem>
         <para>
          将所有引用列或指定的引用列子集设置为它们的默认值。只有 <literal>ON DELETE</literal> 动作才能指定列的子集。（如果默认值不为 null，则被引用表中必须存在与这些默认值匹配的行，否则该操作将失败。）
         </para>

         <para>
          在时态外键中，不支持此选项。
         </para>
        </listitem>
       </varlistentry>
      </variablelist>
     </para>

     <para>
      如果被引用的列经常被修改，那么明智的做法可能是为引用列添加索引，以便能够更高效地执行与该外键约束相关联的引用动作。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-deferrable">
    <term><literal>DEFERRABLE</literal></term>
    <term><literal>NOT DEFERRABLE</literal></term>
    <listitem>
     <para>
      这控制该约束是否可以延迟。不可延迟的约束将在每条命令之后立即检查。可延迟约束的检查可以推迟到事务结束时（使用 <link linkend="sql-set-constraints"><command>SET CONSTRAINTS</command></link> 命令）。<literal>NOT DEFERRABLE</literal> 是默认值。目前，只有 <literal>UNIQUE</literal>、<literal>PRIMARY KEY</literal>、<literal>EXCLUDE</literal> 和 <literal>REFERENCES</literal>（外键）约束接受此子句。<literal>NOT NULL</literal> 和 <literal>CHECK</literal> 约束不可延迟。注意，可延迟约束不能用作包含 <literal>ON CONFLICT</literal> 子句的 <command>INSERT</command> 语句中的冲突仲裁者。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-initially">
    <term><literal>INITIALLY IMMEDIATE</literal></term>
    <term><literal>INITIALLY DEFERRED</literal></term>
    <listitem>
     <para>
      如果约束是可延迟的，此子句指定检查该约束的默认时间。如果约束为 <literal>INITIALLY IMMEDIATE</literal>，则在每条语句之后检查。这是默认值。如果约束为 <literal>INITIALLY DEFERRED</literal>，则仅在事务结束时检查。约束检查时间可以用 <link linkend="sql-set-constraints"><command>SET CONSTRAINTS</command></link> 命令更改。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-enforced">
    <term><literal>ENFORCED</literal></term>
    <term><literal>NOT ENFORCED</literal></term>
    <listitem>
     <para>
      当约束为 <literal>ENFORCED</literal> 时，数据库系统将通过适当的时间检查约束（视情况在每条语句之后或事务结束时）来确保约束得到满足。这是默认值。如果约束为 <literal>NOT ENFORCED</literal>，数据库系统将不检查该约束。此时由应用程序代码来确保约束得到满足。对于不影响结果正确性的优化决策，数据库系统仍可能假定数据实际满足该约束。
     </para>

     <para>
      <literal>NOT ENFORCED</literal> 约束在运行时实际检查约束的代价过高时，可作为文档说明使用。
     </para>

     <para>
      目前仅支持外键约束和 <literal>CHECK</literal> 约束。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-method">
    <term><literal>USING <replaceable class="parameter">method</replaceable></literal></term>
    <listitem>
     <para>
      此可选子句指定用于存储新表内容的表访问方法；该方法必须是
      <literal>TABLE</literal> 类型的访问方法。更多信息请参见 <xref linkend="tableam"/>。如果未指定此选项，则为新表选择默认表访问方法。更多信息请参见
      <xref
      linkend="guc-default-table-access-method"/>。
     </para>
     <para>
      创建分区时，表访问方法即为其分区表的访问方法（如果已设置）。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-with">
    <term><literal>WITH ( <replaceable class="parameter">storage_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] )</literal></term>
    <listitem>
     <para>
      此子句为表或索引指定可选的存储参数；更多信息请参见下面的 <xref linkend="sql-createtable-storage-parameters"/>。为了向后兼容，表的 <literal>WITH</literal> 子句还可以包含 <literal>OIDS=FALSE</literal>，以指定新表的行不应包含 OID（对象标识符），<literal>OIDS=TRUE</literal> 已不再支持。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-without-oids">
    <term><literal>WITHOUT OIDS</literal></term>
    <listitem>
     <para>
      这是用于声明表 <literal>WITHOUT OIDS</literal> 的向后兼容语法，创建表 <literal>WITH
      OIDS</literal> 已不再支持。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-on-commit">
    <term><literal>ON COMMIT</literal></term>
    <listitem>
     <para>
      临时表在事务块结束时的行为可以用 <literal>ON COMMIT</literal> 控制。
      共有三个选项：

      <variablelist>
       <varlistentry id="sql-createtable-parms-on-commit-preserve-rows">
        <term><literal>PRESERVE ROWS</literal></term>
        <listitem>
         <para>
          在事务结束时不做任何特殊动作。
          这是默认行为。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-on-commit-delete-rows">
        <term><literal>DELETE ROWS</literal></term>
        <listitem>
         <para>
          在每个事务块结束时，临时表中的所有行都将被删除。
          实质上，每次提交时都会自动执行一次 <link
          linkend="sql-truncate"><command>TRUNCATE</command></link>。当用于分区表时，
          此操作不会级联到其分区。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createtable-parms-on-commit-drop">
        <term><literal>DROP</literal></term>
        <listitem>
         <para>
          临时表将在当前事务块结束时被删除。当用于分区表时，
          此操作会删除其分区；当用于带有继承子表的表时，
          它会删除依赖的子表。
         </para>
        </listitem>
       </varlistentry>
      </variablelist></para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-tablespace">
    <term><literal>TABLESPACE <replaceable class="parameter">tablespace_name</replaceable></literal></term>
    <listitem>
     <para>
      <replaceable class="parameter">tablespace_name</replaceable> 是将在其中创建新表的表空间的名称。
      如果未指定，则参考
      <xref linkend="guc-default-tablespace"/>；如果表是临时表，则参考
      <xref linkend="guc-temp-tablespaces"/>。对于分区表，由于表本身
      不需要存储，因此在未显式指定其他表空间时，所指定的表空间会覆盖
      <literal>default_tablespace</literal>，作为任何新建分区的默认表空间。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createtable-parms-using-index-tablespace">
    <term><literal>USING INDEX TABLESPACE <replaceable class="parameter">tablespace_name</replaceable></literal></term>
    <listitem>
     <para>
      此子句允许选择将在其中创建与 <literal>UNIQUE</literal>、<literal>PRIMARY
      KEY</literal> 或 <literal>EXCLUDE</literal> 约束
      关联的索引的表空间。
      如果未指定，则参考
      <xref linkend="guc-default-tablespace"/>；如果表是临时表，则参考
      <xref linkend="guc-temp-tablespaces"/>。
     </para>
    </listitem>
   </varlistentry>

  </variablelist>

  <refsect2 id="sql-createtable-storage-parameters" xreflabel="Storage Parameters">
   <title>存储参数</title>

 <indexterm zone="sql-createtable-storage-parameters">
  <primary>storage parameters</primary>
 </indexterm>

   <para>
    <literal>WITH</literal> 子句可以为表指定<firstterm>存储参数</firstterm>，也可以为与 <literal>UNIQUE</literal>、<literal>PRIMARY KEY</literal> 或 <literal>EXCLUDE</literal> 约束关联的索引指定存储参数。
    索引的存储参数记录在 <xref linkend="sql-createindex"/> 中。
    当前可用于表的存储参数如下所列。对于其中许多参数（如下所示），
    还有一个名称相同但带有 <literal>toast.</literal> 前缀的附加参数，
    它控制表的辅助 <acronym>TOAST</acronym> 表（如果有）的行为
    （有关 TOAST 的更多信息，请参见 <xref linkend="storage-toast"/>）。
    如果设置了表参数值而未设置等效的 <literal>toast.</literal> 参数，
    则 TOAST 表将使用表的参数值。
    不支持为分区表指定这些参数，
    但可以为各个叶子分区指定它们。
   </para>

   <variablelist>

    <varlistentry id="reloption-fillfactor" xreflabel="fillfactor">
    <term><varname>fillfactor</varname> (<type>integer</type>)
    <indexterm>
     <primary><varname>fillfactor</varname> 存储参数</primary>
    </indexterm>
    </term>
    <listitem>
     <para>
      表的 fillfactor 是介于 10 和 100 之间的百分比。
      默认值为 100（完全填充）。当指定较小的 fillfactor 时，
      <command>INSERT</command> 操作只会将表页填充到指定的百分比；每个页面上剩余的空间
      保留用于更新该页面上的行。这使 <command>UPDATE</command>
      有机会将行的更新副本放置在与原始行相同的页面上，这比将其放置在不同的
      页面上更高效，并使<link linkend="storage-hot">仅堆元组
      更新</link>更有可能发生。
      对于条目从不更新的表，完全填充是
      最佳选择，但在频繁更新的表中，较小的 fillfactor 是
      合适的。不能为 TOAST 表设置此参数。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-toast-tuple-target" xreflabel="toast_tuple_target">
    <term><literal>toast_tuple_target</literal> (<type>integer</type>)
    <indexterm>
     <primary><varname>toast_tuple_target</varname> 存储参数</primary>
    </indexterm>
    </term>
    <listitem>
     <para>
      toast_tuple_target 指定在我们尝试压缩和/或将长列值移入 TOAST 表之前所需的最小元组长度，同时也是开始 TOAST 处理后我们尝试缩减到的目标长度。这会影响标记为 External（用于移动）、Main（用于压缩）或 Extended（两者兼有）的列，并且仅适用于新元组。对现有行没有影响。
      默认情况下，此参数设置为每个块至少允许 4 个元组，在默认块大小下为 2040 字节。有效值介于 128 字节和（块大小 - 头部）之间，默认为 8160 字节。
      对于非常短或非常长的行，更改此值可能没有用处。
      请注意，默认设置通常接近最优，并且在某些情况下设置此参数可能会产生负面影响。
      不能为 TOAST 表设置此参数。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-parallel-workers" xreflabel="parallel_workers">
    <term><literal>parallel_workers</literal> (<type>integer</type>)
     <indexterm>
     <primary><varname>parallel_workers</varname> 存储参数</primary>
    </indexterm>
    </term>
    <listitem>
     <para>
      这设置应使用多少个工作者来协助对此表进行并行扫描。如果未设置，系统将根据关系大小确定一个值。查询规划器或使用并行扫描的实用程序语句所选择的实际工作者数量可能更少，例如由于 <xref linkend="guc-max-worker-processes"/> 的设置。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-enabled" xreflabel="autovacuum_enabled">
    <term><literal>autovacuum_enabled</literal>, <literal>toast.autovacuum_enabled</literal> (<type>boolean</type>)
    <indexterm>
     <primary><varname>autovacuum_enabled</varname> 存储参数</primary>
    </indexterm>
    </term>
    <listitem>
     <para>
     为特定表启用或禁用自动清理守护进程。
     如果为 true，自动清理守护进程将按照 <xref linkend="autovacuum"/> 中讨论的规则对此表执行自动 <command>VACUUM</command>
     和/或 <command>ANALYZE</command> 操作。
     如果为 false，则不会对此表进行自动清理，除非是为了防止事务 ID 回卷。有关防止回卷的更多信息，请参见 <xref linkend="vacuum-for-wraparound"/>。
     请注意，如果 <xref linkend="guc-autovacuum"/> 参数为 false，自动清理守护进程根本不会运行（除非是为了防止事务 ID 回卷）；设置单个表的存储参数不会覆盖这一点。因此，将此存储参数显式设置为 <literal>true</literal>、而只是设置为 <literal>false</literal>，几乎没有多大意义。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-vacuum-index-cleanup" xreflabel="vacuum_index_cleanup">
    <term><literal>vacuum_index_cleanup</literal>, <literal>toast.vacuum_index_cleanup</literal> (<type>enum</type>)
    <indexterm>
     <primary><varname>vacuum_index_cleanup</varname> 存储参数</primary>
    </indexterm>
    </term>
    <listitem>
     <para>
      控制在对此表运行 <command>VACUUM</command>
      时强制启用或禁用索引清理。默认值为
      <literal>AUTO</literal>。使用 <literal>OFF</literal>
      时禁用索引清理；使用 <literal>ON</literal> 时启用；使用
      <literal>AUTO</literal> 时，每次运行 <command>VACUUM</command> 都会动态作出决定。动态行为使
      <command>VACUUM</command> 能够避免为了删除极少量死元组而不必要地扫描索引。强制禁用所有索引清理可以显著加速
      <command>VACUUM</command>，但如果表修改频繁，也可能导致索引严重膨胀。如果指定了
      <link
       linkend="sql-vacuum"><command>VACUUM</command></link> 的
      <literal>INDEX_CLEANUP</literal> 参数，它将覆盖此选项的值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-vacuum-truncate" xreflabel="vacuum_truncate">
    <term><literal>vacuum_truncate</literal>、<literal>toast.vacuum_truncate</literal>（<type>boolean</type>）
    <indexterm>
     <primary><varname>vacuum_truncate</varname></primary>
     <secondary>storage parameter</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      对应 <xref linkend="guc-vacuum-truncate"/> 参数的每表值。如果指定了 <link linkend="sql-vacuum"><command>VACUUM</command></link> 的 <literal>TRUNCATE</literal> 参数，它将覆盖此选项的值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-threshold" xreflabel="autovacuum_vacuum_threshold">
    <term><literal>autovacuum_vacuum_threshold</literal>、<literal>toast.autovacuum_vacuum_threshold</literal>（<type>integer</type>）
    <indexterm>
     <primary><varname>autovacuum_vacuum_threshold</varname></primary>
     <secondary>storage parameter</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      对应 <xref linkend="guc-autovacuum-vacuum-threshold"/> 参数的每表值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-max-threshold" xreflabel="autovacuum_vacuum_max_threshold">
    <term><literal>autovacuum_vacuum_max_threshold</literal>、<literal>toast.autovacuum_vacuum_max_threshold</literal>（<type>integer</type>）
    <indexterm>
     <primary><varname>autovacuum_vacuum_max_threshold</varname></primary>
     <secondary>storage parameter</secondary>
    </indexterm>
    </term>
   <listitem>
    <para>
     <xref linkend="guc-autovacuum-vacuum-max-threshold"/> 参数的每表值。
    </para>
   </listitem>
  </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-scale-factor" xreflabel="autovacuum_vacuum_scale_factor">
    <term><literal>autovacuum_vacuum_scale_factor</literal>, <literal>toast.autovacuum_vacuum_scale_factor</literal> (<type>floating point</type>)
    <indexterm>
     <primary><varname>autovacuum_vacuum_scale_factor</varname> </primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      <xref linkend="guc-autovacuum-vacuum-scale-factor"/> 参数的每表值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-insert-threshold" xreflabel="autovacuum_vacuum_insert_threshold">
    <term><literal>autovacuum_vacuum_insert_threshold</literal>, <literal>toast.autovacuum_vacuum_insert_threshold</literal> (<type>integer</type>)
    <indexterm>
     <primary><varname>autovacuum_vacuum_insert_threshold</varname></primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      <xref linkend="guc-autovacuum-vacuum-insert-threshold"/> 参数的每表值。特殊值 -1 可用于禁用该表上的插入清理。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-insert-scale-factor" xreflabel="autovacuum_vacuum_insert_scale_factor">
    <term><literal>autovacuum_vacuum_insert_scale_factor</literal>, <literal>toast.autovacuum_vacuum_insert_scale_factor</literal> (<type>floating point</type>)
    <indexterm>
     <primary><varname>autovacuum_vacuum_insert_scale_factor</varname> </primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      表级参数 <xref linkend="guc-autovacuum-vacuum-insert-scale-factor"/> 的值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-analyze-threshold" xreflabel="autovacuum_analyze_threshold">
    <term><literal>autovacuum_analyze_threshold</literal> (<type>integer</type>)
    <indexterm>
     <primary><varname>autovacuum_analyze_threshold</varname></primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      表级参数 <xref linkend="guc-autovacuum-analyze-threshold"/> 的值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-analyze-scale-factor" xreflabel="autovacuum_analyze_scale_factor">
    <term><literal>autovacuum_analyze_scale_factor</literal> (<type>floating point</type>)
    <indexterm>
     <primary><varname>autovacuum_analyze_scale_factor</varname></primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      表级参数 <xref linkend="guc-autovacuum-analyze-scale-factor"/> 的值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-cost-delay" xreflabel="autovacuum_vacuum_cost_delay">
    <term><literal>autovacuum_vacuum_cost_delay</literal>、<literal>toast.autovacuum_vacuum_cost_delay</literal> (<type>floating point</type>)
    <indexterm>
     <primary><varname>autovacuum_vacuum_cost_delay</varname></primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      用于 <xref linkend="guc-autovacuum-vacuum-cost-delay"/>
      参数的每表值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-vacuum-cost-limit" xreflabel="autovacuum_vacuum_cost_limit">
    <term><literal>autovacuum_vacuum_cost_limit</literal>、<literal>toast.autovacuum_vacuum_cost_limit</literal>（<type>integer</type>）
    <indexterm>
     <primary><varname>autovacuum_vacuum_cost_limit</varname></primary>
     <secondary>存储参数</secondary>
    </indexterm>
    </term>
    <listitem>
     <para>
      用于 <xref linkend="guc-autovacuum-vacuum-cost-limit"/>
      参数的每表值。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="reloption-autovacuum-freeze-min-age" xreflabel="autovacuum_freeze_min_age">
