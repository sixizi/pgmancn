<refentry id="sql-revoke">
 <indexterm zone="sql-revoke">
  <primary>REVOKE</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>REVOKE</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>REVOKE</refname>
  <refpurpose>移除访问权限</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
REVOKE [ GRANT OPTION FOR ]
    { { SELECT | INSERT | UPDATE | DELETE | TRUNCATE | REFERENCES | TRIGGER | MAINTAIN }
    [, ...] | ALL [ PRIVILEGES ] }
    ON { [ TABLE ] <replaceable class="parameter">table_name</replaceable> [, ...]
         | ALL TABLES IN SCHEMA <replaceable>schema_name</replaceable> [, ...] }
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { { SELECT | INSERT | UPDATE | REFERENCES } ( <replaceable class="parameter">column_name</replaceable> [, ...] )
    [, ...] | ALL [ PRIVILEGES ] ( <replaceable class="parameter">column_name</replaceable> [, ...] ) }
    ON [ TABLE ] <replaceable class="parameter">table_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { { USAGE | SELECT | UPDATE }
    [, ...] | ALL [ PRIVILEGES ] }
    ON { SEQUENCE <replaceable class="parameter">sequence_name</replaceable> [, ...]
         | ALL SEQUENCES IN SCHEMA <replaceable>schema_name</replaceable> [, ...] }
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { { CREATE | CONNECT | TEMPORARY | TEMP } [, ...] | ALL [ PRIVILEGES ] }
    ON DATABASE <replaceable>database_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { USAGE | ALL [ PRIVILEGES ] }
    ON DOMAIN <replaceable>domain_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { USAGE | ALL [ PRIVILEGES ] }
    ON FOREIGN DATA WRAPPER <replaceable>fdw_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { USAGE | ALL [ PRIVILEGES ] }
    ON FOREIGN SERVER <replaceable>server_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { EXECUTE | ALL [ PRIVILEGES ] }
    ON { { FUNCTION | PROCEDURE | ROUTINE } <replaceable>function_name</replaceable> [ ( [ [ <replaceable class="parameter">argmode</replaceable> ] [ <replaceable class="parameter">arg_name</replaceable> ] <replaceable class="parameter">arg_type</replaceable> [, ...] ] ) ] [, ...]
         | ALL { FUNCTIONS | PROCEDURES | ROUTINES } IN SCHEMA <replaceable>schema_name</replaceable> [, ...] }
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { USAGE | ALL [ PRIVILEGES ] }
    ON LANGUAGE <replaceable>lang_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { { SELECT | UPDATE } [, ...] | ALL [ PRIVILEGES ] }
    ON LARGE OBJECT <replaceable class="parameter">loid</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { { SET | ALTER SYSTEM } [, ...] | ALL [ PRIVILEGES ] }
    ON PARAMETER <replaceable class="parameter">configuration_parameter</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { { CREATE | USAGE } [, ...] | ALL [ PRIVILEGES ] }
    ON SCHEMA <replaceable>schema_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { CREATE | ALL [ PRIVILEGES ] }
    ON TABLESPACE <replaceable>tablespace_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ GRANT OPTION FOR ]
    { USAGE | ALL [ PRIVILEGES ] }
    ON TYPE <replaceable>type_name</replaceable> [, ...]
    FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

REVOKE [ { ADMIN | INHERIT | SET } OPTION FOR ]
    <replaceable class="parameter">role_name</replaceable> [, ...] FROM <replaceable class="parameter">role_specification</replaceable> [, ...]
    [ GRANTED BY <replaceable class="parameter">role_specification</replaceable> ]
    [ CASCADE | RESTRICT ]

<phrase>where <replaceable class="parameter">role_specification</replaceable> can be:</phrase>

    [ GROUP ] <replaceable class="parameter">role_name</replaceable>
  | PUBLIC
  | CURRENT_ROLE
  | CURRENT_USER
  | SESSION_USER
</synopsis>
 </refsynopsisdiv>

 <refsect1 id="sql-revoke-description">
  <title>描述</title>

  <para>
   <command>REVOKE</command> 命令从一个或多个角色收回先前授予的权限。关键字 <literal>PUBLIC</literal> 指代隐式定义的所有角色组成的组。
  </para>

  <para>
   有关权限类型的含义，请参见 <link linkend="sql-grant"><command>GRANT</command></link> 命令的描述。
  </para>

  <para>
   注意，任何特定角色拥有的权限是直接授予它的权限、授予它当前所属的任何角色的权限以及授予 <literal>PUBLIC</literal> 的权限之和。因此，例如从 <literal>PUBLIC</literal> 收回 <literal>SELECT</literal> 权限并不一定意味着所有角色都失去了对该对象的 <literal>SELECT</literal> 权限：那些被直接授予或通过其他角色获得该权限的角色仍然拥有它。同样，如果 <literal>PUBLIC</literal> 或其他成员角色仍然拥有 <literal>SELECT</literal> 权限，那么从某个用户收回 <literal>SELECT</literal> 可能并不能阻止该用户使用 <literal>SELECT</literal>。
  </para>

  <para>
   如果指定了 <literal>GRANT OPTION FOR</literal>，则只收回该权限的授予选项，而不收回权限本身。否则，权限和授予选项都会被收回。
  </para>

  <para>
   如果一个用户持有带授予选项的权限并且已将其授予其他用户，那么这些其他用户所持有的权限被称为依赖权限。如果第一个用户持有的该权限或授予选项正被收回并且存在依赖权限，那么在指定了 <literal>CASCADE</literal> 的情况下这些依赖权限也会被收回；如果没有指定，则收回操作将失败。这种递归收回只影响通过可追溯到作为此 <literal>REVOKE</literal> 命令主体的用户的那条用户链所授予的权限。因此，如果该权限也通过其他用户授予过，受影响的用户实际上可能仍然保留该权限。
  </para>

  <para>
   在收回表上的权限时，表每一列上相应的列权限（如果有）也会被自动收回。另一方面，如果某个角色已被授予了表上的权限，那么从各列收回相同的权限将不会产生任何效果。
  </para>

  <para>
   在收回角色中的成员资格时，<literal>GRANT OPTION</literal> 改为被称为 <literal>ADMIN OPTION</literal>，但行为类似。请注意，在 <productname>PostgreSQL</productname> 16 之前的版本中，对于角色成员资格的授予并不跟踪依赖权限，因此 <literal>CASCADE</literal> 对角色成员资格没有效果。现在情况已不再如此。另请注意，这种形式的命令不允许在 <replaceable class="parameter">role_specification</replaceable> 中使用噪声词 <literal>GROUP</literal>。
  </para>

  <para>
   正如可以从现有的角色授予中移除 <literal>ADMIN OPTION</literal> 一样，也可以收回 <literal>INHERIT OPTION</literal> 或 <literal>SET OPTION</literal>。这等价于将相应选项的值设置为 <literal>FALSE</literal>。
  </para>
 </refsect1>

 <refsect1 id="sql-revoke-notes">
  <title>说明</title>

  <para>
   用户只能收回由该用户直接授予的权限。例如，如果用户 A 将带有授予选项的权限授予了用户 B，而用户 B 又将其授予了用户 C，那么用户 A 不能直接从 C 收回该权限。相反，用户 A 可以从用户 B 收回授予选项并使用 <literal>CASCADE</literal> 选项，从而使该权限依次从用户 C 收回。再举一个例子，如果 A 和 B 都将相同的权限授予了 C，则 A 可以收回自己做出的授予，但不能收回 B 的授予，因此 C 实际上仍将拥有该权限。
  </para>

   <para>
    当对象的非属主尝试对该对象执行 <command>REVOKE</command> 权限操作时，如果用户对该对象没有任何权限，该命令将直接失败。只要用户拥有某些权限，命令就会继续执行，但只会撤销用户对其持有授予选项的那些权限。<command>REVOKE ALL
    PRIVILEGES</command> 形式在没有持有任何授予选项时会发出警告消息，而其他形式在未持有命令中明确指定的任何权限的授予选项时会发出警告。（原则上这些说明也适用于对象属主，但由于属主始终被视为持有所有授予选项，因此这些情况永远不会发生。）
   </para>

   <para>
    如果超级用户选择发出 <command>GRANT</command> 或 <command>REVOKE</command> 命令，该命令会按照由受影响对象的属主发出的方式来执行。（由于角色没有属主，在 <command>GRANT</command> 角色成员关系的情况下，该命令会按照由引导超级用户发出的方式来执行。）由于所有权限最终都来自对象属主（可能通过授予选项链间接而来），超级用户有可能撤销所有权限，但这可能需要如上所述使用 <literal>CASCADE</literal>。
   </para>

   <para>
    <command>REVOKE</command> can also be done by a role
    that is not the owner of the affected object, but is a member of the role
    that owns the object, or is a member of a role that holds privileges
    <literal>WITH GRANT OPTION</literal> on the object.  In this case the
    command is performed as though it were issued by the containing role that
    actually owns the object or holds the privileges
    <literal>WITH GRANT OPTION</literal>.  For example, if table
    <literal>t1</literal> is owned by role <literal>g1</literal>, of which role
    <literal>u1</literal> is a member, then <literal>u1</literal> can revoke privileges
    on <literal>t1</literal> that are recorded as being granted by <literal>g1</literal>.
    This would include grants made by <literal>u1</literal> as well as by other
    members of role <literal>g1</literal>.
   </para>

   <para>
    如果执行 <command>REVOKE</command> 的角色通过多条角色成员关系路径间接持有权限，则未指定将使用哪个包含角色来执行该命令。在这种情况下，最佳实践是使用 <command>SET ROLE</command> 切换到你想以其身份执行 <command>REVOKE</command> 的特定角色。否则可能会导致撤销并非你本意的权限，或者根本不撤销任何权限。
   </para>

   <para>
    有关特定权限类型以及如何检查对象权限的更多信息，请参见 <xref linkend="ddl-priv"/>。
   </para>
 </refsect1>

 <refsect1 id="sql-revoke-examples">
  <title>示例</title>

  <para>
   撤销 public 在表 <literal>films</literal> 上的插入权限：

<programlisting>
REVOKE INSERT ON films FROM PUBLIC;
</programlisting>
  </para>

  <para>
   撤销用户 <literal>manuel</literal> 在视图 <literal>kinds</literal> 上的所有权限：

<programlisting>
REVOKE ALL PRIVILEGES ON kinds FROM manuel;
</programlisting>

   注意，这实际上意味着<quote>撤销我所授予的所有权限</quote>。
  </para>

  <para>
   撤销用户 <literal>joe</literal> 在角色 <literal>admins</literal> 中的成员资格：

<programlisting>
REVOKE admins FROM joe;
</programlisting></para>
 </refsect1>

 <refsect1 id="sql-revoke-compatibility">
  <title>兼容性</title>

   <para>
    <link linkend="sql-grant"><command>GRANT</command></link> 命令的兼容性说明同样适用于 <command>REVOKE</command>。
    按照标准要求，需要使用关键字 <literal>RESTRICT</literal> 或 <literal>CASCADE</literal>，但 <productname>PostgreSQL</productname>
    默认假定为 <literal>RESTRICT</literal>。
   </para>
 </refsect1>

