doc/src/sgml/ref/create_aggregate.sgml
PostgreSQL documentation
-->

<refentry id="sql-createaggregate">
 <indexterm zone="sql-createaggregate">
  <primary>CREATE AGGREGATE</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>CREATE AGGREGATE</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>CREATE AGGREGATE</refname>
  <refpurpose>定义一个新的聚合函数</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
CREATE [ OR REPLACE ] AGGREGATE <replaceable class="parameter">name</replaceable> ( [ <replaceable class="parameter">argmode</replaceable> ] [ <replaceable class="parameter">argname</replaceable> ] <replaceable class="parameter">arg_data_type</replaceable> [ , ... ] ) (
    SFUNC = <replaceable class="parameter">sfunc</replaceable>,
    STYPE = <replaceable class="parameter">state_data_type</replaceable>
    [ , SSPACE = <replaceable class="parameter">state_data_size</replaceable> ]
    [ , FINALFUNC = <replaceable class="parameter">ffunc</replaceable> ]
    [ , FINALFUNC_EXTRA ]
    [ , FINALFUNC_MODIFY = { READ_ONLY | SHAREABLE | READ_WRITE } ]
    [ , COMBINEFUNC = <replaceable class="parameter">combinefunc</replaceable> ]
    [ , SERIALFUNC = <replaceable class="parameter">serialfunc</replaceable> ]
    [ , DESERIALFUNC = <replaceable class="parameter">deserialfunc</replaceable> ]
    [ , INITCOND = <replaceable class="parameter">initial_condition</replaceable> ]
    [ , MSFUNC = <replaceable class="parameter">msfunc</replaceable> ]
    [ , MINVFUNC = <replaceable class="parameter">minvfunc</replaceable> ]
    [ , MSTYPE = <replaceable class="parameter">mstate_data_type</replaceable> ]
    [ , MSSPACE = <replaceable class="parameter">mstate_data_size</replaceable> ]
    [ , MFINALFUNC = <replaceable class="parameter">mffunc</replaceable> ]
    [ , MFINALFUNC_EXTRA ]
    [ , MFINALFUNC_MODIFY = { READ_ONLY | SHAREABLE | READ_WRITE } ]
    [ , MINITCOND = <replaceable class="parameter">minitial_condition</replaceable> ]
    [ , SORTOP = <replaceable class="parameter">sort_operator</replaceable> ]
    [ , PARALLEL = { SAFE | RESTRICTED | UNSAFE } ]
)

CREATE [ OR REPLACE ] AGGREGATE <replaceable class="parameter">name</replaceable> ( [ [ <replaceable class="parameter">argmode</replaceable> ] [ <replaceable class="parameter">argname</replaceable> ] <replaceable class="parameter">arg_data_type</replaceable> [ , ... ] ]
                        ORDER BY [ <replaceable class="parameter">argmode</replaceable> ] [ <replaceable class="parameter">argname</replaceable> ] <replaceable class="parameter">arg_data_type</replaceable> [ , ... ] ) (
    SFUNC = <replaceable class="parameter">sfunc</replaceable>,
    STYPE = <replaceable class="parameter">state_data_type</replaceable>
    [ , SSPACE = <replaceable class="parameter">state_data_size</replaceable> ]
    [ , FINALFUNC = <replaceable class="parameter">ffunc</replaceable> ]
    [ , FINALFUNC_EXTRA ]
    [ , FINALFUNC_MODIFY = { READ_ONLY | SHAREABLE | READ_WRITE } ]
    [ , INITCOND = <replaceable class="parameter">initial_condition</replaceable> ]
    [ , PARALLEL = { SAFE | RESTRICTED | UNSAFE } ]
    [ , HYPOTHETICAL ]
)

<phrase>or the old syntax</phrase>

CREATE [ OR REPLACE ] AGGREGATE <replaceable class="parameter">name</replaceable> (
    BASETYPE = <replaceable class="parameter">base_type</replaceable>,
    SFUNC = <replaceable class="parameter">sfunc</replaceable>,
    STYPE = <replaceable class="parameter">state_data_type</replaceable>
    [ , SSPACE = <replaceable class="parameter">state_data_size</replaceable> ]
    [ , FINALFUNC = <replaceable class="parameter">ffunc</replaceable> ]
    [ , FINALFUNC_EXTRA ]
    [ , FINALFUNC_MODIFY = { READ_ONLY | SHAREABLE | READ_WRITE } ]
    [ , COMBINEFUNC = <replaceable class="parameter">combinefunc</replaceable> ]
    [ , SERIALFUNC = <replaceable class="parameter">serialfunc</replaceable> ]
    [ , DESERIALFUNC = <replaceable class="parameter">deserialfunc</replaceable> ]
    [ , INITCOND = <replaceable class="parameter">initial_condition</replaceable> ]
    [ , MSFUNC = <replaceable class="parameter">msfunc</replaceable> ]
    [ , MINVFUNC = <replaceable class="parameter">minvfunc</replaceable> ]
    [ , MSTYPE = <replaceable class="parameter">mstate_data_type</replaceable> ]
    [ , MSSPACE = <replaceable class="parameter">mstate_data_size</replaceable> ]
    [ , MFINALFUNC = <replaceable class="parameter">mffunc</replaceable> ]
    [ , MFINALFUNC_EXTRA ]
    [ , MFINALFUNC_MODIFY = { READ_ONLY | SHAREABLE | READ_WRITE } ]
    [ , MINITCOND = <replaceable class="parameter">minitial_condition</replaceable> ]
    [ , SORTOP = <replaceable class="parameter">sort_operator</replaceable> ]
)
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>描述</title>

  <para>
   <command>CREATE AGGREGATE</command> 定义一个新的聚合函数。
   <command>CREATE OR REPLACE AGGREGATE</command> 将定义一个新的聚合函数或替换现有定义。发行版中包含一些基本且常用的聚合函数；它们记录在 <xref linkend="functions-aggregate"/> 中。如果定义了新类型或需要尚未提供的聚合函数，则可以使用 <command>CREATE AGGREGATE</command> 来提供所需的功能。
  </para>

  <para>
   替换现有定义时，参数类型、结果类型和直接参数的数量不能更改。此外，新定义必须与旧定义属于同一种类（普通聚合、有序集聚合或假设集聚合）。
  </para>

  <para>
   如果给出了模式名（例如 <literal>CREATE AGGREGATE
   myschema.myagg ...</literal>），则在该指定模式中创建聚合函数。否则在当前模式中创建。
  </para>

  <para>
   聚合函数由其名称和输入数据类型标识。同一模式中的两个聚合如果操作不同的输入类型，则可以具有相同的名称。聚合的名称和输入数据类型还必须与同一模式中每个普通函数的名称和输入数据类型不同。此行为与普通函数名的重载相同（参见 <xref linkend="sql-createfunction"/>）。
  </para>

  <para>
   一个简单的聚合函数由一个或两个普通函数构成：
一个状态转移函数
<replaceable class="parameter">sfunc</replaceable>，
以及一个可选的最终计算函数
<replaceable class="parameter">ffunc</replaceable>。
它们的使用方式如下：
<programlisting>
<replaceable class="parameter">sfunc</replaceable>( internal-state, next-data-values ) ---> next-internal-state
<replaceable class="parameter">ffunc</replaceable>( internal-state ) ---> aggregate-value
</programlisting>
  </para>

  <para>
   <productname>PostgreSQL</productname> 创建一个数据类型为 <replaceable class="parameter">stype</replaceable>
的临时变量，用于保存该聚合的当前内部状态。在处理每个输入行时，
计算聚合参数值，并以当前状态值和
新的参数值调用状态转移函数，计算出新的
内部状态值。处理完所有行之后，
调用一次最终函数以计算该聚合的返回
值。如果没有最终函数，则按原样返回结束时的
状态值。
  </para>

  <para>
   聚合函数可以提供一个初始条件，
即内部状态值的初始值。
它在数据库中以 <type>text</type> 类型的值来指定和存储，
但它必须是状态值数据类型的一个常量的
合法外部表示。如果未提供，
则状态值初始为 null。
  </para>

  <para>
   如果状态转移函数被声明为 <quote>strict</quote>，
那么它不能用 null 输入调用。使用这样的转移
函数时，聚合的执行行为如下。任何含有 null 输入
值的行都会被忽略（不调用该函数，并保留之前的
状态值）。如果初始状态值为 null，那么在第一个
所有输入值均非 null 的行上，第一个参数值将替换
状态值，并在其后每个所有输入值均非 null 的行上
调用转移函数。
这对于实现像 <function>max</function> 这样的聚合很方便。
注意，仅当
<replaceable class="parameter">state_data_type</replaceable>
与第一个
<replaceable class="parameter">arg_data_type</replaceable> 相同时，才能使用此行为。
当这些类型不同时，必须提供一个非 null 的初始
条件，或使用非严格的状态转移函数。
  </para>

  <para>
   如果状态转移函数不是严格的，那么它将在每个输入行上
被无条件地调用，并且必须自行处理 null 输入
和 null 状态值。这使聚合的作者能够完全控制
聚合对 null 值的处理。
  </para>

  <para>
   如果最终函数被声明为 <quote>strict</quote>，那么当结束状态值为 null 时它不会被调用；而是自动返回一个 null 结果。（当然，这不过是 strict 函数的正常行为。）无论如何，最终函数都可以选择返回 null 值。例如，<function>avg</function> 的最终函数在发现输入行数为零时返回 null。
  </para>

  <para>
   有时把最终函数声明为不仅接受状态值，还接受与聚合输入值对应的额外参数是很有用的。这样做的主要原因是，如果最终函数是多态的，而状态值的数据类型不足以确定结果类型。这些额外参数总是以 NULL 传递（因此在使用 <literal>FINALFUNC_EXTRA</literal> 选项时最终函数不能是 strict 的），但它们仍然是有效的参数。例如，最终函数可以利用 <function>get_fn_expr_argtype</function> 来标识当前调用中的实际参数类型。
  </para>

  <para>
   聚合可以选择支持<firstterm>移动聚合模式</firstterm>，如 <xref linkend="xaggr-moving-aggregates"/> 中所述。这需要指定 <literal>MSFUNC</literal>、<literal>MINVFUNC</literal> 和 <literal>MSTYPE</literal> 参数，以及可选的 <literal>MSSPACE</literal>、<literal>MFINALFUNC</literal>、<literal>MFINALFUNC_EXTRA</literal>、<literal>MFINALFUNC_MODIFY</literal> 和 <literal>MINITCOND</literal> 参数。除 <literal>MINVFUNC</literal> 之外，这些参数的作用类似于不带 <literal>M</literal> 的相应简单聚合参数；它们定义了聚合的一个单独实现，其中包含一个逆转移函数。
  </para>

  <para>
   参数列表中含有 <literal>ORDER BY</literal> 的语法会创建一种特殊类型的聚合，称为<firstterm>有序集聚合</firstterm>；如果指定了 <literal>HYPOTHETICAL</literal>，则创建<firstterm>假想集聚合</firstterm>。这些聚合以依赖于顺序的方式对已排序的值组进行操作，因此指定输入排序顺序是调用中必不可少的一部分。此外，它们还可以有<firstterm>直接</firstterm>参数，这些参数在每次聚合中只求值一次，而不是每个输入行求值一次。假想集聚合是有序集聚合的一个子类，其中某些直接参数在数量和数据类型上必须与聚合参数列相匹配。这使得这些直接参数的值可以作为额外的<quote>假想</quote>行添加到聚合输入行的集合中。
  </para>

  <para>
   聚合函数可以选择支持<firstterm>部分聚合</firstterm>，如<xref linkend="xaggr-partial-aggregates"/>所述。这需要指定 <literal>COMBINEFUNC</literal> 参数。如果 <replaceable class="parameter">state_data_type</replaceable> 为 <type>internal</type>，通常还应当提供 <literal>SERIALFUNC</literal> 和 <literal>DESERIALFUNC</literal> 参数，以便能够进行并行聚合。注意，还必须把该聚合函数标记为 <literal>PARALLEL SAFE</literal> 才能启用并行聚合。
  </para>

  <para>
   行为类似于 <function>MIN</function> 或 <function>MAX</function> 的聚合函数有时可以通过查询索引而不是扫描每一行输入来优化。如果该聚合函数可以这样优化，请通过指定一个<firstterm>排序运算符</firstterm>来表明这一点。基本要求是，该聚合函数必须产生由该运算符所诱导的排序中的第一个元素；换句话说：
<programlisting>
SELECT agg(col) FROM tab;
</programlisting>
   必须等价于：
<programlisting>
SELECT col FROM tab ORDER BY col USING sortop LIMIT 1;
</programlisting>
   进一步的假设是，该聚合函数忽略空输入，并且当且仅当没有非空输入时才返回空结果。通常，数据类型的 <literal>&lt;</literal> 运算符是 <function>MIN</function> 的合适排序运算符，而 <literal>&gt;</literal> 是 <function>MAX</function> 的合适排序运算符。注意，除非指定的运算符是 B-tree 索引运算符类中的<quote>小于</quote>或<quote>大于</quote>策略成员，否则该优化实际上永远不会生效。
  </para>

  <para>
   要能够创建聚合函数，你必须对参数类型、状态类型以及返回类型具有 <literal>USAGE</literal> 权限，并且对支撑函数具有 <literal>EXECUTE</literal> 权限。
  </para>
 </refsect1>

 <refsect1>
  <title>参数</title>

  <variablelist>
   <varlistentry>
    <term><replaceable class="parameter">name</replaceable></term>
    <listitem>
     <para>
      要创建的聚合函数的名称（可以选择性地使用模式限定）。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">argmode</replaceable></term>

    <listitem>
     <para>
      参数的模式：<literal>IN</literal> 或 <literal>VARIADIC</literal>。
      （聚合函数不支持 <literal>OUT</literal> 参数。）
      如果省略，默认为 <literal>IN</literal>。只有最后一个参数可以标记为 <literal>VARIADIC</literal>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">argname</replaceable></term>

    <listitem>
     <para>
      一个参数的名字。当前这仅对文档目的有用。如果省略，该参数没有名字。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">arg_data_type</replaceable></term>
    <listitem>
     <para>
      该聚合函数所操作的输入数据类型。要创建一个零参数聚合函数，请写 <literal>*</literal> 来代替参数说明列表。（这种聚合的一个例子是 <function>count(*)</function>。）
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">base_type</replaceable></term>
    <listitem>
     <para>
      在 <command>CREATE AGGREGATE</command> 的旧语法中，输入数据类型由 <literal>basetype</literal> 参数指定，而不是写在聚合名旁边。注意这种语法只允许一个输入参数。要用这种语法定义零参数聚合函数，请把 <literal>basetype</literal> 指定为 <literal>"ANY"</literal>（而不是 <literal>*</literal>）。有序集聚合不能用旧语法定义。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">sfunc</replaceable></term>
    <listitem>
     <para>
      要为每个输入行调用的状态转移函数的名字。对于普通的 <replaceable class="parameter">N</replaceable> 参数聚合函数，<replaceable class="parameter">sfunc</replaceable> 必须接受 <replaceable class="parameter">N</replaceable>+1 个参数，第一个参数的类型为 <replaceable
      class="parameter">state_data_type</replaceable>，其余参数与聚合所声明的输入数据类型相匹配。该函数必须返回 <replaceable
      class="parameter">state_data_type</replaceable> 类型的值。该函数接受当前状态值和当前输入数据值，并返回下一个状态值。
     </para>

     <para>
      对于有序集（包括假设集）聚合，状态转移函数只接收当前状态值和被聚合的参数，而不接收直接参数。除此之外，其他方面相同。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">state_data_type</replaceable></term>
    <listitem>
     <para>
      聚合的状态值的数据类型。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">state_data_size</replaceable></term>
    <listitem>
     <para>
      聚合状态值的大致平均大小（以字节计）。
      如果省略此参数或将其设为零，则会基于 <replaceable>state_data_type</replaceable> 使用一个默认估计值。
      查询规划器使用该值来估计分组聚合查询所需的内存。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">ffunc</replaceable></term>
    <listitem>
     <para>
      在所有输入行都被遍历之后，用于计算聚合结果的最终函数名。
      对于普通聚合，此函数必须接受一个类型为 <replaceable
      class="parameter">state_data_type</replaceable> 的单一参数。聚合的返回数据类型被定义为该函数的返回类型。如果未指定 <replaceable class="parameter">ffunc</replaceable>，则使用结束状态值作为聚合的结果，并且返回类型为 <replaceable
      class="parameter">state_data_type</replaceable>。
     </para>

     <para>
      对于有序集聚合（包括假设集聚合），最终函数不仅接收最终状态值，还接收所有直接参数的值。
     </para>

     <para>
      如果指定了 <literal>FINALFUNC_EXTRA</literal>，那么除了最终状态值和任何直接参数之外，最终函数还会接收与聚合的常规（被聚合）参数相对应的额外 NULL 值。这主要用于在定义多态聚合时能够正确解析聚合结果类型。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>FINALFUNC_MODIFY</literal> = { <literal>READ_ONLY</literal> | <literal>SHAREABLE</literal> | <literal>READ_WRITE</literal> }</term>
    <listitem>
     <para>
      此选项指定最终函数是否为不修改其参数的纯函数。<literal>READ_ONLY</literal> 表示它不是；另外两个值表示它可能更改转移状态值。更多细节请参见下面的 <xref linkend="sql-createaggregate-notes"/>。默认值为 <literal>READ_ONLY</literal>，但对于有序集聚合，默认值为 <literal>READ_WRITE</literal>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">combinefunc</replaceable></term>
    <listitem>
     <para>
      可以选择指定 <replaceable class="parameter">combinefunc</replaceable> 函数，以允许聚合函数支持部分聚合。如果提供，<replaceable class="parameter">combinefunc</replaceable> 必须组合两个 <replaceable class="parameter">state_data_type</replaceable> 值（每个值都包含对输入值的某个子集进行聚合的结果），以产生一个新的 <replaceable class="parameter">state_data_type</replaceable>，它表示对两组输入进行聚合的结果。可以将此函数视为一个 <replaceable class="parameter">sfunc</replaceable>，只不过它不是作用于单个输入行并将其添加到运行中的聚合状态，而是将另一个聚合状态添加到运行状态中。
     </para>

     <para>
      <replaceable class="parameter">combinefunc</replaceable> 必须声明为接受两个 <replaceable class="parameter">state_data_type</replaceable> 类型的参数并返回一个 <replaceable class="parameter">state_data_type</replaceable> 类型的值。此函数可选地可以是<quote>严格的</quote>。在这种情况下，当任一输入状态为空时不会调用该函数；另一个状态将被视为正确的结果。
     </para>

     <para>
      对于 <replaceable class="parameter">state_data_type</replaceable> 为 <type>internal</type> 的聚合函数，<replaceable class="parameter">combinefunc</replaceable> 不能是严格的。在这种情况下，<replaceable class="parameter">combinefunc</replaceable> 必须确保正确处理空状态，并确保返回的状态被正确地存储在聚合内存上下文中。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">serialfunc</replaceable></term>
    <listitem>
     <para>
      <replaceable class="parameter">state_data_type</replaceable> 为 <type>internal</type> 的聚合函数只有在具有 <replaceable class="parameter">serialfunc</replaceable> 函数时才能参与并行聚合，该函数必须把聚合状态序列化为一个 <type>bytea</type> 值以便传输到另一个进程。此函数必须接受一个类型为 <type>internal</type> 的单一参数并返回类型 <type>bytea</type>。还需要一个对应的 <replaceable class="parameter">deserialfunc</replaceable>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">deserialfunc</replaceable></term>
    <listitem>
     <para>
      将先前序列化的聚合状态反序列化回 <replaceable class="parameter">state_data_type</replaceable>。此函数必须接受两个类型分别为 <type>bytea</type> 和 <type>internal</type> 的参数，并产生一个类型为 <type>internal</type> 的结果。（注意：第二个 <type>internal</type> 参数未被使用，但出于类型安全的考虑是必需的。）
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">initial_condition</replaceable></term>
    <listitem>
     <para>
      状态值的初始设置。这必须是一个采用数据类型 <replaceable
      class="parameter">state_data_type</replaceable> 所接受形式的字符串常量。如果未指定，状态值初始为空。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">msfunc</replaceable></term>
    <listitem>
     <para>
      在移动聚合模式下为每个输入行调用的正向状态转移函数的名称。这与常规转移函数完全相同，只是其第一个参数和结果的类型为 <replaceable>mstate_data_type</replaceable>，这可能与 <replaceable>state_data_type</replaceable> 不同。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">minvfunc</replaceable></term>
    <listitem>
     <para>
      在移动聚合模式下使用的逆向状态转移函数的名称。此函数具有与 <replaceable>msfunc</replaceable> 相同的参数类型和结果类型，但它用于从当前聚合状态中移除一个值，而不是向其中添加一个值。逆向转移函数必须具有与正向状态转移函数相同的严格性属性。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">mstate_data_type</replaceable></term>
    <listitem>
     <para>
      使用移动聚合模式时，聚合状态值的数据类型。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">mstate_data_size</replaceable></term>
    <listitem>
     <para>
      使用移动聚合模式时，聚合状态值的近似平均大小（以字节计）。其工作方式与 <replaceable>state_data_size</replaceable> 相同。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">mffunc</replaceable></term>
    <listitem>
     <para>
      在使用移动聚合模式时，遍历完所有输入行后调用以计算聚合结果的最终函数的名称。其工作方式与 <replaceable>ffunc</replaceable> 相同，只是其第一个参数的类型为 <replaceable>mstate_data_type</replaceable>，并且通过书写 <literal>MFINALFUNC_EXTRA</literal> 来指定额外的哑参数。由 <replaceable>mffunc</replaceable> 或 <replaceable>mstate_data_type</replaceable> 确定的聚合结果类型必须与聚合的常规实现所确定的类型相匹配。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>MFINALFUNC_MODIFY</literal> = { <literal>READ_ONLY</literal> | <literal>SHAREABLE</literal> | <literal>READ_WRITE</literal> }</term>
    <listitem>
     <para>
      此选项类似于 <literal>FINALFUNC_MODIFY</literal>，但它描述的是移动聚合最终函数的行为。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">minitial_condition</replaceable></term>
    <listitem>
     <para>
      使用移动聚合模式时状态值的初始设置。其工作方式与 <replaceable>initial_condition</replaceable> 相同。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><replaceable class="parameter">sort_operator</replaceable></term>
    <listitem>
     <para>
      用于 <function>MIN</function> 或 <function>MAX</function> 类聚合函数的关联排序运算符。
      这只是一个运算符名称（可以带模式限定）。
      假定该运算符具有与聚合函数相同的输入数据类型
      （该聚合函数必须是单参数普通聚合函数）。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>PARALLEL =</literal> { <literal>SAFE</literal> | <literal>RESTRICTED</literal> | <literal>UNSAFE</literal> }</term>
    <listitem>
     <para>
      <literal>PARALLEL SAFE</literal>、<literal>PARALLEL
      RESTRICTED</literal> 和 <literal>PARALLEL UNSAFE</literal> 的含义与
      <link linkend="sql-createfunction"><command>CREATE FUNCTION</command></link> 中相同。如果聚合函数被标记为 <literal>PARALLEL
      UNSAFE</literal>（这是默认值！）或 <literal>PARALLEL RESTRICTED</literal>，
      则不会考虑将其并行化。
      请注意，规划器不会参考聚合函数的支持函数的并行安全性标记，
      只参考聚合函数本身的标记。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry>
    <term><literal>HYPOTHETICAL</literal></term>
    <listitem>
     <para>
      仅对于有序集聚合函数，此标志指定按照假想集聚合函数的要求
      处理聚合函数参数：也就是说，最后几个直接参数必须
      与聚合（<literal>WITHIN GROUP</literal>）参数的数据类型匹配。
      <literal>HYPOTHETICAL</literal> 标志对运行时行为没有影响，
      只影响解析时对聚合函数参数的数据类型和排序规则的解析。
     </para>
    </listitem>
   </varlistentry>
  </variablelist>

  <para>
   <command>CREATE AGGREGATE</command> 的参数可以按任意顺序书写，
   而不只是上面示例中的顺序。
  </para>
 </refsect1>

 <refsect1 id="sql-createaggregate-notes" xreflabel="Notes">
  <title>说明</title>

   <para>
    在指定支持函数名称的参数中，如有需要可以写上
    模式名，例如 <literal>SFUNC = public.sum</literal>。
    但是不要在那里写参数类型，&mdash; 支持函数的参数类型
    是由其他参数决定的。
   </para>

   <para>
    通常，PostgreSQL 函数应当是真正的函数，即不修改其输入值。不过，聚合转移函数<emphasis>在聚合的上下文中使用时</emphasis>，允许取巧并就地修改其转移状态参数。与每次都为转移状态制作一份新副本相比，这可以带来可观的性能收益。
   </para>

   <para>
    同样，虽然聚合最终函数通常不应修改其输入值，但有时无法避免修改转移状态参数。此类行为必须使用 <literal>FINALFUNC_MODIFY</literal> 参数来声明。<literal>READ_WRITE</literal> 值表示最终函数以未指定的方式修改转移状态。该值会阻止将该聚合用作窗口函数，同时也会阻止对共享相同输入值和转移函数的聚合调用进行转移状态合并。<literal>SHAREABLE</literal> 值表示在最终函数之后不能再应用转移函数，但可以对结束时的转移状态值执行多次最终函数调用。该值会阻止将该聚合用作窗口函数，但允许合并转移状态。（也就是说，这里关注的优化不是重复应用同一个最终函数，而是将不同的最终函数应用于同一个结束时的转移状态值。只要没有任何最终函数被标记为 <literal>READ_WRITE</literal>，这就是允许的。）
   </para>

   <para>
    如果一个聚合支持移动聚合模式，那么当该聚合被用作窗口函数、且窗口的帧起点是移动的（即帧起点模式不是 <literal>UNBOUNDED PRECEDING</literal>）时，它将提高计算效率。从概念上讲，正向转移函数在输入值从底部进入窗口帧时把它们加入聚合的状态，而逆向转移函数在它们从顶部离开帧时再把它们移除。因此，当值被移除时，它们总是按照被加入时的相同顺序被移除。于是，每当逆向转移函数被调用时，它接收到的总是最早加入但尚未移除的参数值。逆向转移函数可以假定，在它移除最旧的行之后，当前状态中至少还会保留一行。（当情况并非如此时，窗口函数机制会直接开始一次全新的聚合，而不是使用逆向转移函数。）
   </para>

   <para>
    移动聚合模式的正向转移函数不允许返回 NULL 作为新的状态值。如果逆向转移函数返回 NULL，这被视为一种指示：逆向函数无法针对这个特定输入逆转状态计算，因此将针对当前帧起始位置从头重新进行聚合计算。这一约定使得移动聚合模式可以用于这样的情形：其中存在一些不常见的、无法从运行中的状态值中逆转出来的情况。
   </para>

   <para>
    如果没有提供移动聚合实现，该聚合仍然可以与移动帧一起使用，但每当帧的起点移动时，<productname>PostgreSQL</productname> 都会重新计算整个聚合。请注意，无论聚合是否支持移动聚合模式，<productname>PostgreSQL</productname> 都能在不重新计算的情况下处理移动的帧终点；这是通过继续向聚合的状态中添加新值来实现的。这就是为什么将聚合用作窗口函数要求最终函数是只读的：它不得破坏聚合的状态值，以便即使在针对某一组帧边界获得了一个聚合结果值之后，聚合仍能继续下去。
   </para>

   <para>
    有序集聚合的语法允许为最后一个直接参数和最后一个聚合（<literal>WITHIN GROUP</literal>）参数指定 <literal>VARIADIC</literal>。然而，当前的实现从两个方面限制了 <literal>VARIADIC</literal> 的使用。首先，有序集聚合只能使用 <literal>VARIADIC "any"</literal>，不能使用其他可变数组类型。其次，如果最后一个直接参数是 <literal>VARIADIC "any"</literal>，那么只能有一个聚合参数，并且它也必须为 <literal>VARIADIC "any"</literal>。（在系统目录所使用的表示中，这两个参数被合并为单个 <literal>VARIADIC "any"</literal> 项，因为 <structname>pg_proc</structname> 无法表示带有多个 <literal>VARIADIC</literal> 参数的函数。）如果该聚合是假想集聚合，那么与 <literal>VARIADIC "any"</literal> 参数匹配的直接参数就是假想参数；任何前面的参数都表示额外的直接参数，它们不受匹配聚合参数的约束。
   </para>

   <para>
    目前，有序集聚合不需要支持移动聚合模式，因为它们不能用作窗口函数。
   </para>

   <para>
    目前，有序集聚合不支持部分（包括并行）聚合。此外，对于包含 <literal>DISTINCT</literal> 或 <literal>ORDER BY</literal> 子句的聚合调用，它将永远不会被使用，因为这些语义无法在部分聚合期间得到支持。
  </para>
 </refsect1>

 <refsect1>
  <title>示例</title>

  <para>
   请参阅 <xref linkend="xaggr"/>。
  </para>
 </refsect1>

 <refsect1>
  <title>兼容性</title>

  <para>
   <command>CREATE AGGREGATE</command> 是一种 <productname>PostgreSQL</productname> 语言扩展。SQL 标准没有规定用户定义的聚合函数。
  </para>
 </refsect1>

 <refsect1>
  <title>另请参阅</title>

  <simplelist type="inline">
   <member><xref linkend="sql-alteraggregate"/></member>
   <member><xref linkend="sql-dropaggregate"/></member>
  </simplelist>
 </refsect1>
</refentry>
