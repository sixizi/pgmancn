<!--
doc/src/sgml/ref/create_subscription.sgml
PostgreSQL documentation
-->

<refentry id="sql-createsubscription">
 <indexterm zone="sql-createsubscription">
  <primary>CREATE SUBSCRIPTION</primary>
 </indexterm>

 <refmeta>
  <refentrytitle>CREATE SUBSCRIPTION</refentrytitle>
  <manvolnum>7</manvolnum>
  <refmiscinfo>SQL - Language Statements</refmiscinfo>
 </refmeta>

 <refnamediv>
  <refname>CREATE SUBSCRIPTION</refname>
  <refpurpose>定义一个新的订阅</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
<synopsis>
CREATE SUBSCRIPTION <replaceable class="parameter">subscription_name</replaceable>
    CONNECTION '<replaceable class="parameter">conninfo</replaceable>'
    PUBLICATION <replaceable class="parameter">publication_name</replaceable> [, ...]
    [ WITH ( <replaceable class="parameter">subscription_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] ) ]
</synopsis>
 </refsynopsisdiv>

 <refsect1>
  <title>描述</title>

  <para>
   <command>CREATE SUBSCRIPTION</command> 添加一个新的逻辑复制订阅。创建订阅的用户成为该订阅的所有者。订阅名称必须与当前数据库中任何现有订阅的名称不同。
  </para>

  <para>
   订阅表示到发布端的复制连接。因此，除了在本地系统目录中添加定义之外，该命令通常还会在发布端创建一个复制槽。
  </para>

  <para>
   除非订阅最初被禁用，否则在运行该命令的事务提交时，将启动一个逻辑复制工作者来为新订阅复制数据。
  </para>

  <para>
   要能够创建订阅，您必须具有 <literal>pg_create_subscription</literal> 角色的权限，以及当前数据库上的 <literal>CREATE</literal> 权限。
  </para>

  <para>
   关于订阅以及整个逻辑复制的附加信息可在 <xref linkend="logical-replication-subscription"/> 和 <xref linkend="logical-replication"/> 中找到。
  </para>

 </refsect1>

 <refsect1>
  <title>参数</title>

  <variablelist>
   <varlistentry id="sql-createsubscription-params-name">
    <term><replaceable class="parameter">subscription_name</replaceable></term>
    <listitem>
     <para>
      新订阅的名称。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createsubscription-params-connection">
    <term><literal>CONNECTION '<replaceable class="parameter">conninfo</replaceable>'</literal></term>
    <listitem>
     <para>
      <application>libpq</application> 连接串，用于定义如何连接到发布者数据库。详情请参见
      <xref linkend="libpq-connstring"/>。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createsubscription-params-publication">
    <term><literal>PUBLICATION <replaceable class="parameter">publication_name</replaceable> [, ...]</literal></term>
    <listitem>
     <para>
      要订阅的发布者上发布的名称。
     </para>
    </listitem>
   </varlistentry>

   <varlistentry id="sql-createsubscription-params-with">
    <term><literal>WITH ( <replaceable class="parameter">subscription_parameter</replaceable> [= <replaceable class="parameter">value</replaceable>] [, ... ] )</literal></term>
    <listitem>
     <para>
      此子句指定订阅的可选参数。
     </para>

     <para>
      下列参数控制创建订阅期间的行为：

      <variablelist>

       <varlistentry id="sql-createsubscription-params-with-connect">
        <term><literal>connect</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定 <command>CREATE SUBSCRIPTION</command>
          命令是否应该连接到发布端。默认值为 <literal>true</literal>。将此参数设置为
          <literal>false</literal> 会强制将
          <literal>create_slot</literal>、<literal>enabled</literal> 和
          <literal>copy_data</literal> 的值设为 <literal>false</literal>。
          （不能将 <literal>connect</literal>
          设置为 <literal>false</literal> 与将 <literal>create_slot</literal>、<literal>enabled</literal>
          或 <literal>copy_data</literal> 设置为 <literal>true</literal> 组合使用。）
         </para>

         <para>
          由于此选项为 <literal>false</literal> 时不会建立连接，因此不会订阅任何表。要启动
          复制，你必须手动创建复制槽，在需要时启用故障转移，启用订阅，并刷新
          订阅。有关示例，请参见
          <xref linkend="logical-replication-subscription-examples-deferred-slot"/>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-create-slot">
        <term><literal>create_slot</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定该命令是否应在发布端创建复制槽。默认值为 <literal>true</literal>。
         </para>
         <para>
          如果设置为 <literal>false</literal>，则由你负责以其他方式创建发布端的槽。有关示例，请参见
          <xref linkend="logical-replication-subscription-examples-deferred-slot"/>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-enabled">
        <term><literal>enabled</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定订阅是应该主动进行复制，还是只进行设置但尚未启动。默认值为
          <literal>true</literal>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-slot-name">
        <term><literal>slot_name</literal> (<type>string</type>)</term>
        <listitem>
         <para>
          要使用的发布端复制槽的名称。默认使用订阅的名称作为槽名称。
         </para>

         <para>
          将 <literal>slot_name</literal> 设置为 <literal>NONE</literal> 意味着该订阅不会关联任何复制槽。此类订阅还必须将 <literal>enabled</literal> 和 <literal>create_slot</literal> 都设置为 <literal>false</literal>。当你稍后要手动创建复制槽时，请使用此设置。有关示例，请参见 <xref linkend="logical-replication-subscription-examples-deferred-slot"/>。
         </para>

         <para>
          当把 <literal>slot_name</literal> 设置为一个有效名称、并把 <literal>create_slot</literal> 设置为 <literal>false</literal> 时，所指定槽的 <literal>failover</literal> 属性值可能与订阅中对应的 <literal>failover</literal> 参数不同。请始终确保槽属性 <literal>failover</literal> 与订阅的对应参数相匹配，反之亦然。否则，发布端上的槽的行为可能与这些订阅选项所声明的不同：例如，即使订阅的 <literal>failover</literal> 选项被禁用，发布端上的槽仍可能被同步到备机；或者即使订阅的 <literal>failover</literal> 选项被启用，该槽仍可能被禁止同步。
         </para>
        </listitem>
       </varlistentry>
      </variablelist>
     </para>

     <para>
      以下参数控制订阅创建之后的复制行为：

      <variablelist>

       <varlistentry id="sql-createsubscription-params-with-binary">
        <term><literal>binary</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定订阅是否请求发布端以二进制格式（而非文本格式）发送数据。默认值为 <literal>false</literal>。任何初始表同步复制（参见 <literal>copy_data</literal>）也使用相同的格式。二进制格式可能比文本格式更快，但它在不同机器架构和 <productname>PostgreSQL</productname> 版本之间的可移植性较差。二进制格式与数据类型高度相关；例如，它不允许从 <type>smallint</type> 列复制到 <type>integer</type> 列，尽管在文本格式下这样做是可以的。即使启用了此选项，也只有具有二进制发送和接收函数的数据类型才会以二进制形式传输。请注意，初始同步要求所有数据类型都具有二进制发送和接收函数，否则同步将失败（有关发送/接收函数的更多信息，请参见 <xref linkend="sql-createtype"/>）。
         </para>

         <para>
          在进行跨版本复制时，可能出现发布端对某种数据类型具有二进制发送函数，但订阅端缺少该类型的二进制接收函数的情况。在这种情况下，数据传输将失败，并且不能使用 <literal>binary</literal> 选项。
         </para>

         <para>
          如果发布端是 16 之前的 <productname>PostgreSQL</productname> 版本，那么任何初始表同步都将使用文本格式，即使 <literal>binary = true</literal>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-copy-data">
        <term><literal>copy_data</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定在复制启动时是否复制所订阅的发布中已存在的数据。默认值为 <literal>true</literal>。
         </para>
         <para>
          如果发布包含 <literal>WHERE</literal> 子句，将影响复制哪些数据。详情请参阅 <xref linkend="sql-createsubscription-notes" />。
         </para>
         <para>
          有关 <literal>copy_data = true</literal> 如何与 <literal>origin</literal> 参数相互作用的详细信息，请参阅 <xref linkend="sql-createsubscription-notes"/>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-streaming">
        <term><literal>streaming</literal> (<type>enum</type>)</term>
        <listitem>
         <para>
          指定是否为此订阅启用进行中事务的流式传输。默认值为 <literal>parallel</literal>，表示传入的更改会通过某个并行应用工作者（如果可用）直接应用。如果没有空闲的并行应用工作者来处理流式事务，则更改会写入临时文件，并在事务提交后应用。请注意，如果并行应用工作者中发生错误，远程事务的结束 LSN 可能不会报告到服务器日志中。
         </para>

         <caution>
          <para>
           当发布端和订阅端的模式不同时，存在死锁的风险，尽管这类情况很少见。应用工作进程具备自动重试这些事务的能力。
          </para>
         </caution>

         <para>
          如果设置为 <literal>on</literal>，传入的更改会被写入临时文件，只有在发布端事务提交并且订阅端接收到之后才会被应用。
         </para>

         <para>
          如果设置为 <literal>off</literal>，所有事务都在发布端完整解码，然后才作为一个整体发送给订阅端。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-synchronous-commit">
        <term><literal>synchronous_commit</literal> (<type>enum</type>)</term>
        <listitem>
         <para>
          此参数的值会覆盖此订阅的应用工作进程内的 <xref linkend="guc-synchronous-commit"/> 设置。默认值为 <literal>off</literal>。
         </para>

         <para>
          对逻辑复制使用 <literal>off</literal> 是安全的：如果订阅端因为缺少同步而丢失了事务，数据将再次从发布端发送。
         </para>

         <para>
          在执行同步逻辑复制时，可能需要不同的设置。逻辑复制工作进程会向发布端报告写入和刷写的位置，而在使用同步复制时，发布端将等待实际的刷写。这意味着，当订阅用于同步复制时，为订阅端将 <literal>synchronous_commit</literal> 设置为 <literal>off</literal> 可能会增加发布端上 <command>COMMIT</command> 的延迟。在这种情况下，将 <literal>synchronous_commit</literal> 设置为 <literal>local</literal> 或更高可能是有利的。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-two-phase">
        <term><literal>two_phase</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定是否为该订阅启用两阶段提交。默认值为 <literal>false</literal>。
         </para>

         <para>
          启用两阶段提交时，预备事务会在 <command>PREPARE
          TRANSACTION</command> 时发送给订阅者，并在订阅者上同样作为两阶段事务处理。否则，预备事务仅在提交时发送给订阅者，随后由订阅者立即处理。
         </para>

         <para>
          两阶段提交的实现要求复制已成功完成初始表同步阶段。因此，即使为某个订阅启用了 <literal>two_phase</literal>，内部的二阶段状态也会暂时保持为 <quote>pending</quote>，直到初始化阶段完成。请参阅 <link linkend="catalog-pg-subscription"><structname>pg_subscription</structname></link> 的 <structfield>subtwophasestate</structfield> 列，以了解实际的二阶段状态。
         </para>

        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-disable-on-error">
        <term><literal>disable_on_error</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定当订阅工作者在从发布者进行数据复制期间检测到任何错误时，是否应自动禁用该订阅。默认值为 <literal>false</literal>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-password-required">
        <term><literal>password_required</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          如果设置为 <literal>true</literal>，则作为该订阅的结果而建立的到发布者的连接必须使用密码认证，并且密码必须作为连接字符串的一部分指定。当订阅由超级用户拥有时，此设置会被忽略。默认值为 <literal>true</literal>。只有超级用户才能将此值设置为 <literal>false</literal>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-run-as-owner">
        <term><literal>run_as_owner</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          如果为 true，所有复制操作都以订阅所有者的身份执行。如果为 false，复制工作者将以各表所有者的身份对每张表执行操作。后一种配置通常安全得多；详情请参见 <xref linkend="logical-replication-security" />。默认值为 <literal>false</literal>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-origin">
        <term><literal>origin</literal> (<type>string</type>)</term>
        <listitem>
         <para>
          指定订阅是否请求发布者只发送没有 origin 的更改，还是无论 origin 如何都发送更改。将 <literal>origin</literal> 设置为 <literal>none</literal> 表示订阅将请求发布者只发送没有 origin 的更改。将 <literal>origin</literal> 设置为 <literal>any</literal> 表示发布者无论更改的 origin 是什么都会发送。默认值为 <literal>any</literal>。
         </para>
         <para>
          有关 <literal>copy_data = true</literal> 如何与 <literal>origin</literal> 参数交互的详细信息，请参见 <xref linkend="sql-createsubscription-notes"/>。
         </para>
        </listitem>
       </varlistentry>

       <varlistentry id="sql-createsubscription-params-with-failover">
        <term><literal>failover</literal> (<type>boolean</type>)</term>
        <listitem>
         <para>
          指定与订阅关联的复制槽是否启用同步到备库，以便在故障转移后可以从新的主库恢复逻辑复制。默认值为 <literal>false</literal>。
         </para>
        </listitem>
       </varlistentry>
      </variablelist></para>

    </listitem>
   </varlistentry>
  </variablelist>

  <para>
   当指定类型为 <type>boolean</type> 的参数时，可以省略 <literal>=</literal> <replaceable class="parameter">value</replaceable> 部分，这等价于指定 <literal>TRUE</literal>。
  </para>
 </refsect1>

 <refsect1 id="sql-createsubscription-notes" xreflabel="Notes">
  <title>说明</title>

  <para>
   有关如何配置订阅与发布实例之间的访问控制的详细信息，请参见 <xref linkend="logical-replication-security"/>。
  </para>

  <para>
   在创建复制槽时（默认行为），<command>CREATE
   SUBSCRIPTION</command> 不能在事务块内执行。
  </para>

  <para>
   创建连接到同一数据库集簇的订阅（例如，在同一集簇中的数据库之间复制，或在同一数据库内复制）只有在复制槽不是作为同一条命令的一部分创建时才会成功。否则，<command>CREATE
   SUBSCRIPTION</command> 调用将会挂起。要使其正常工作，请单独创建复制槽（使用函数 <function>pg_create_logical_replication_slot</function> 并指定插件名 <literal>pgoutput</literal>），并使用参数 <literal>create_slot = false</literal> 创建订阅。示例请参见 <xref linkend="logical-replication-subscription-examples-deferred-slot"/>。这是一项实现上的限制，可能会在未来的版本中取消。
  </para>

  <para>
   如果发布中的任何表带有 <literal>WHERE</literal> 子句，则 <replaceable class="parameter">expression</replaceable> 求值为 <literal>false</literal> 或 <literal>NULL</literal> 的行将不会被发布。如果订阅包含多个发布，且同一张表在这些发布中以不同的 <literal>WHERE</literal> 子句发布，那么只要其中任一表达式（针对该发布操作）得到满足，该行就会被发布。对于不同的 <literal>WHERE</literal> 子句，如果其中一个发布没有 <literal>WHERE</literal> 子句（针对该发布操作），或者该发布被声明为 <link linkend="sql-createpublication-params-for-all-tables"><literal>FOR ALL TABLES</literal></link> 或 <link linkend="sql-createpublication-params-for-tables-in-schema"><literal>FOR TABLES IN SCHEMA</literal></link>，则无论其他表达式如何定义，行始终会被发布。如果订阅方是 15 之前的 <productname>PostgreSQL</productname> 版本，那么在初始数据同步阶段会忽略任何行过滤。在这种情况下，用户可能需要考虑删除任何与后续过滤不兼容的初始复制数据。由于初始数据同步在复制现有表数据时不会考虑发布的 <link linkend="sql-createpublication-params-with-publish"><literal>publish</literal></link> 参数，因此可能会复制一些使用 DML 时不会被复制的行。示例请参见 <xref linkend="logical-replication-subscription-examples"/>。
  </para>

  <para>
   不支持订阅包含多个发布、且同一张表在这些发布中以不同的列列表发布的情况。
  </para>

  <para>
   我们允许指定不存在的发布，以便用户稍后添加它们。这意味着 <link linkend="catalog-pg-subscription"><structname>pg_subscription</structname></link> 可以包含不存在的发布。
  </para>

  <para>
   当使用 <literal>copy_data = true</literal> 和 <literal>origin = NONE</literal> 的订阅参数组合时，初始同步的表数据直接从发布端复制，这意味着无法得知该数据的真实来源。如果发布端本身也有订阅，那么复制的表数据可能源自更上游的节点。这种情况会被检测到，并向用户记录一条 WARNING，但该警告只是表明可能存在问题的提示；用户有责任进行必要的检查，以确保复制的数据来源确实符合预期。
  </para>

  <para>
   要找出哪些表可能包含非本地来源（由于在发布端创建了其他订阅），请尝试以下 SQL 查询：
<programlisting>
# substitute &lt;pub-names&gt; below with your publication name(s) to be queried
SELECT DISTINCT PT.schemaname, PT.tablename
FROM pg_publication_tables PT
     JOIN pg_class C ON (C.relname = PT.tablename)
     JOIN pg_namespace N ON (N.nspname = PT.schemaname),
     pg_subscription_rel PS
WHERE C.relnamespace = N.oid AND
      (PS.srrelid = C.oid OR
      C.oid IN (SELECT relid FROM pg_partition_ancestors(PS.srrelid) UNION
                SELECT relid FROM pg_partition_tree(PS.srrelid))) AND
      PT.pubname IN (&lt;pub-names&gt;);
</programlisting></para>

 </refsect1>

 <refsect1>
  <title>示例</title>

  <para>
   创建一个到远程服务器的订阅，复制 <literal>mypublication</literal> 和 <literal>insert_only</literal> 发布中的表，并在提交时立即开始复制：
<programlisting>
CREATE SUBSCRIPTION mysub
         CONNECTION 'host=192.168.1.50 port=5432 user=foo dbname=foodb'
        PUBLICATION mypublication, insert_only;
</programlisting>
  </para>

  <para>
   创建一个到远程服务器的订阅，复制 <literal>insert_only</literal> 发布中的表，并且在稍后启用之前不开始复制。
<programlisting>
CREATE SUBSCRIPTION mysub
         CONNECTION 'host=192.168.1.50 port=5432 user=foo dbname=foodb'
        PUBLICATION insert_only
               WITH (enabled = false);
</programlisting></para>
 </refsect1>

 <refsect1>
  <title>兼容性</title>

  <para>
   <command>CREATE SUBSCRIPTION</command> 是一个 <productname>PostgreSQL</productname>
   扩展。
  </para>
 </refsect1>

